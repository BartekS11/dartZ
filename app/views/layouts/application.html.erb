<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <title><%= theme_app_name %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png" type="image/png">
  <script>
    (function() {
      const theme = localStorage.getItem("dartz_theme_mode") || "dark"
      document.documentElement.dataset.theme = theme
      document.documentElement.classList.toggle("dark", theme === "dark")
    })()
  </script>
  <%= javascript_importmap_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap", crossorigin: "anonymous" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "bulma_bridge", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "dartz_theme", "data-turbo-track": "reload" %>
  <meta name="turbo-cache-control" content="no-store">
</head>

<body class="dartz-body" data-controller="theme-mode">
  <div class="app-shell">
    <header class="app-header">
      <nav class="simple-nav" aria-label="Primary navigation" data-controller="profile-menu">
        <div class="simple-nav-top">
          <%= link_to root_path, class: "brand-lockup" do %>
            <span class="brand-mark" aria-hidden="true">◎</span>
            <span class="brand-copy">
              <span class="brand-wordmark"><%= theme_app_name.delete(theme_app_accent) %><span><%= theme_app_accent %></span></span>
              <span class="brand-subline"><%= Current.user ? Current.user.display_name : "501" %></span>
            </span>
          <% end %>

          <% if content_for?(:mobile_header_action) %>
            <%= yield :mobile_header_action %>
          <% end %>
        </div>

        <div class="simple-nav-scroll">
          <%= link_to "Match", matches_path, class: "app-nav-link #{'is-active' if current_page?(matches_path)}" %>
          <%= link_to "Bot", new_bot_match_path, class: "app-nav-link #{'is-active' if current_page?(new_bot_match_path)}" %>
          <%= link_to "Tournaments", tournaments_path, class: "app-nav-link #{'is-active' if request.path.start_with?(tournaments_path)}" %>
          <% if premium_access? %>
            <%= link_to "Dart setup", edit_dart_setup_path, class: "app-nav-link #{'is-active' if request.path.start_with?(edit_dart_setup_path)}" %>
          <% end %>

          <% if content_for?(:nav_inline_action) %>
            <%= yield :nav_inline_action %>
          <% end %>

          <% if Current.user %>
            <%= link_to "Upgrade", billing_path, class: "app-nav-link app-nav-auth-inline #{'is-active' if current_page?(billing_path)}" %>

            <button id="profileMenuButton" class="app-nav-link" type="button" data-profile-menu-target="button" data-action="profile-menu#toggle" aria-controls="profileMenu" aria-expanded="false">
              Account ▾
            </button>

            <%= button_to "Logout", session_path,
                  method: :delete,
                  class: "app-nav-auth-button is-danger mono",
                  form_class: "app-nav-auth-form",
                  form: { onsubmit: "localStorage.removeItem('dartz_player1');localStorage.removeItem('dartz_player2');localStorage.removeItem('dartz_players');localStorage.removeItem('dartz_matches');" } %>
          <% else %>
            <%= link_to "Register", new_registration_path, class: "app-nav-auth-button app-nav-auth-inline mono #{'is-active' if current_page?(new_registration_path)}" %>
            <%= link_to "Login", new_session_path, class: "app-nav-auth-button is-danger mono #{'is-active' if current_page?(new_session_path)}" %>
          <% end %>

          <button type="button"
                  class="app-nav-link app-nav-theme-toggle"
                  data-action="theme-mode#toggle"
                  data-theme-mode-target="button"
                  aria-label="Switch theme">
            <span class="icon" data-theme-mode-target="icon" aria-hidden="true">☀</span>
            <span data-theme-mode-target="label" class="visually-hidden">Light theme</span>
          </button>
        </div>

        <% if Current.user %>
          <div id="profileMenu" data-profile-menu-target="menu" class="hidden profile-menu-panel">
            <div>
              <div class="eyebrow">Signed in as</div>
              <div class="profile-name"><%= Current.user.display_name %></div>
              <div class="profile-email"><%= Current.user.email_address %></div>
              <span class="theme-chip <%= premium_access? ? 'is-live' : '' %>">Tier: <%= Current.user.account_tier.humanize %></span>
            </div>
            <hr>
            <%= form_with model: Current.user, url: profile_path, method: :patch, class: "stack-sm" do |f| %>
              <%= f.label :nickname, "Nickname", class: "auth-label" %>
              <%= f.text_field :nickname, maxlength: 20, placeholder: "Set your nickname", class: "theme-form-input mono" %>
              <%= f.submit "Save nickname", class: "button theme-btn-primary mono" %>
            <% end %>
            <hr>
            <div class="stack-sm">
              <% if premium_access? %>
                <%= link_to "Dart setup", edit_dart_setup_path, class: "button theme-btn-primary mono" %>
              <% end %>
              <%= link_to "Upgrade", billing_path, class: "button theme-btn-outline mono" %>
              <%= button_to "Logout", session_path,
                    method: :delete,
                    class: "button theme-btn-outline mono w-full",
                    form: { onsubmit: "localStorage.removeItem('dartz_player1');localStorage.removeItem('dartz_player2');localStorage.removeItem('dartz_players');localStorage.removeItem('dartz_matches');" } %>
            </div>
          </div>
        <% end %>
      </nav>
    </header>

    <main class="app-main">
      <% if notice %>
        <div class="theme-notification is-success-light mono mb-4">✓ <%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="theme-notification is-danger-light mono mb-4">! <%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="app-footer">
      <div class="footer-inner">
        <span class="footer-brand"><%= theme_app_name %></span>
        <div class="footer-links">
          <%= link_to "Privacy", privacy_policy_path %>
          <%= link_to "Terms", terms_of_service_path %>
          <%= link_to "Contact", contact_page_path %>
        </div>
      </div>
    </footer>
  </div>
</body>
</html>
