<!DOCTYPE html>
<html lang="en" data-theme="dark" style="<%= theme_css_variables %>">
<head>
  <title><%= theme_app_name %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script>
    (function() {
      const theme = localStorage.getItem("dartz_theme_mode") || "dark"
      document.documentElement.dataset.theme = theme
    })()
  </script>
  <%= javascript_importmap_tags %>
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", crossorigin: "anonymous" %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "dartz_theme", "data-turbo-track": "reload" %>
  <meta name="turbo-cache-control" content="no-store">
</head>

<body class="dartz-body" data-controller="theme-mode">
  <div class="theme-shell flex min-h-screen flex-col">
    <header class="site-header">
      <div class="site-header-frame mx-auto flex max-w-7xl flex-col gap-3 px-4 py-3 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between gap-3">
          <%= link_to root_path, class: "brand-lockup min-w-0" do %>
            <span class="brand-mark shrink-0">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M12 3v18M3 12h18" stroke="var(--theme-line-strong)" stroke-linecap="round"/>
                <circle cx="12" cy="12" r="7" stroke="var(--theme-primary)"/>
                <circle cx="12" cy="12" r="2" fill="var(--theme-primary)"/>
              </svg>
            </span>
            <span class="min-w-0">
              <span class="brand-wordmark bebas block"><%= theme_app_name.delete(theme_app_accent) %><span class="accent"><%= theme_app_accent %></span></span>
              <span class="brand-subline mono"><%= Current.user ? Current.user.display_name : "Fast 501 scoring" %></span>
            </span>
          <% end %>

          <div class="site-header-actions">
            <% if content_for?(:mobile_header_action) %>
              <%= yield :mobile_header_action %>
            <% end %>
            <button type="button"
                    class="btn btn-sm theme-btn-outline rounded-pill theme-toggle mono"
                    data-action="theme-mode#toggle"
                    data-theme-mode-target="button"
                    aria-label="Toggle light and dark mode">
              <span data-theme-mode-target="icon">◐</span>
              <span data-theme-mode-target="label">Dark</span>
            </button>

            <% if Current.user %>
              <details class="profile-menu">
                <summary class="profile-menu-summary mono" aria-label="Open profile menu">☰</summary>
                <div class="profile-menu-panel">
                  <div>
                    <div class="profile-menu-label mono mb-1">Signed in as</div>
                    <div class="bebas text-3xl leading-none"><%= Current.user.display_name %></div>
                    <div class="mono mt-1 text-xs" style="color:var(--theme-subtle)"><%= Current.user.email_address %></div>
                    <div class="mt-2">
                      <span class="theme-chip mono <%= premium_access? ? 'is-live' : '' %>">Tier: <%= Current.user.account_tier.humanize %></span>
                    </div>
                  </div>

                  <div class="profile-menu-divider"></div>

                  <%= form_with model: Current.user, url: profile_path, method: :patch, class: "grid gap-2" do |f| %>
                    <div>
                      <label class="profile-menu-label mono mb-2 block">Nickname</label>
                      <%= f.text_field :nickname,
                            maxlength: 20,
                            placeholder: "Set your nickname",
                            class: "form-control theme-form-input mono" %>
                    </div>
                    <%= f.submit "Save nickname", class: "btn btn-sm theme-btn-primary rounded-pill mono" %>
                  <% end %>

                  <div class="profile-menu-divider"></div>

                  <% if premium_access? %>
                    <%= link_to "Dart setup", edit_dart_setup_path, class: "btn btn-sm theme-btn-primary rounded-pill mono w-100" %>
                  <% else %>
                    <div class="mono text-xs" style="color:var(--theme-subtle)">Premium: dart setup customization locked.</div>
                  <% end %>
                  <%= link_to "Upgrade", billing_path, class: "btn btn-sm theme-btn-outline rounded-pill mono w-100 mt-2" %>

                  <div class="profile-menu-divider"></div>

                  <%= button_to "Logout", session_path,
                        method: :delete,
                        class: "btn btn-sm theme-btn-outline rounded-pill mono w-100",
                        form: {
                          onsubmit: "localStorage.removeItem('dartz_player1');localStorage.removeItem('dartz_player2');localStorage.removeItem('dartz_players');localStorage.removeItem('dartz_matches');"
                        } %>
                </div>
              </details>
            <% end %>
          </div>
        </div>

        <nav class="app-nav mono" aria-label="Primary">
          <%= link_to "Match", matches_path, class: "app-nav-link #{'is-active' if current_page?(matches_path)}" %>
          <%= link_to "Bot", new_bot_match_path, class: "app-nav-link #{'is-active' if current_page?(new_bot_match_path)}" %>
          <%= link_to "Tournaments", tournaments_path, class: "app-nav-link #{'is-active' if request.path.start_with?(tournaments_path)}" %>
          <% if Current.user %>
            <%= link_to "Upgrade", billing_path, class: "app-nav-link #{'is-active' if current_page?(billing_path)}" %>
          <% end %>
          <% if premium_access? %>
            <%= link_to "Dart setup", edit_dart_setup_path, class: "app-nav-link #{'is-active' if request.path.start_with?(edit_dart_setup_path)}" %>
          <% end %>
          <% unless Current.user %>
            <%= link_to "Login", new_session_path, class: "app-nav-link #{'is-active' if current_page?(new_session_path)}" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="mx-auto flex w-full max-w-7xl flex-1 flex-col px-4 py-4 sm:px-6 md:py-6 lg:px-8">
      <% if notice %>
        <div class="flash-theme notice mono mb-4">✓ <%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="flash-theme alert mono mb-4">! <%= alert %></div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-5 text-sm sm:px-6 lg:px-8">
        <span class="mono" style="color:var(--theme-subtle)"><%= theme_app_name %></span>
        <div class="flex flex-wrap gap-3">
          <%= link_to "Privacy", privacy_policy_path, class: "footer-link" %>
          <%= link_to "Terms", terms_of_service_path, class: "footer-link" %>
          <%= link_to "Contact", contact_page_path, class: "footer-link" %>
        </div>
      </div>
    </footer>
  </div>
</body>
</html>
