<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <title><%= theme_app_name %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <script>
    (function() {
      const theme = localStorage.getItem("dartz_theme_mode") || "dark"
      document.documentElement.dataset.theme = theme
    })()
  </script>
  <%= javascript_importmap_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%= stylesheet_link_tag "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Oswald:wght@400;500;600;700&display=swap", crossorigin: "anonymous" %>
  <%= stylesheet_link_tag "https://cdn.jsdelivr.net/npm/bulma@1.0.2/css/bulma.min.css", crossorigin: "anonymous" %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "bulma_bridge", "data-turbo-track": "reload" %>
  <%= stylesheet_link_tag "dartz_theme", "data-turbo-track": "reload" %>
  <meta name="turbo-cache-control" content="no-store">
</head>

<body class="dartz-body" data-controller="theme-mode">
  <div class="app-shell">
    <header class="app-header">
      <nav class="navbar is-transparent" role="navigation" aria-label="Primary navigation">
        <div class="container is-max-widescreen">
          <div class="navbar-brand">
            <%= link_to root_path, class: "navbar-item brand-lockup" do %>
              <span class="brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 3v18M3 12h18" stroke="var(--theme-line-strong)" stroke-linecap="round"/>
                  <circle cx="12" cy="12" r="7" stroke="var(--theme-primary)"/>
                  <circle cx="12" cy="12" r="2" fill="var(--theme-primary)"/>
                </svg>
              </span>
              <span>
                <span class="brand-wordmark"><%= theme_app_name.delete(theme_app_accent) %><span><%= theme_app_accent %></span></span>
                <span class="brand-subline"><%= Current.user ? Current.user.display_name : "Fast 501 scoring" %></span>
              </span>
            <% end %>
          </div>

          <div class="navbar-menu is-active app-navbar-menu">
            <div class="navbar-start app-nav">
              <%= link_to "Match", matches_path, class: "navbar-item app-nav-link #{'is-active' if current_page?(matches_path)}" %>
              <%= link_to "Bot", new_bot_match_path, class: "navbar-item app-nav-link #{'is-active' if current_page?(new_bot_match_path)}" %>
              <%= link_to "Tournaments", tournaments_path, class: "navbar-item app-nav-link #{'is-active' if request.path.start_with?(tournaments_path)}" %>
              <% if Current.user %>
                <%= link_to "Upgrade", billing_path, class: "navbar-item app-nav-link #{'is-active' if current_page?(billing_path)}" %>
              <% end %>
              <% if premium_access? %>
                <%= link_to "Dart setup", edit_dart_setup_path, class: "navbar-item app-nav-link #{'is-active' if request.path.start_with?(edit_dart_setup_path)}" %>
              <% end %>
              <% unless Current.user %>
                <%= link_to "Login", new_session_path, class: "navbar-item app-nav-link #{'is-active' if current_page?(new_session_path)}" %>
              <% end %>
            </div>

            <div class="navbar-end app-actions">
              <% if content_for?(:mobile_header_action) %>
                <div class="navbar-item"><%= yield :mobile_header_action %></div>
              <% end %>

              <div class="navbar-item">
                <button type="button"
                        class="button is-small theme-btn-outline theme-toggle mono"
                        data-action="theme-mode#toggle"
                        data-theme-mode-target="button"
                        aria-label="Toggle light and dark mode">
                  <span data-theme-mode-target="icon">◐</span>
                  <span data-theme-mode-target="label">Dark</span>
                </button>
              </div>

              <% if Current.user %>
                <div class="navbar-item">
                  <details class="profile-menu">
                    <summary class="profile-menu-summary mono" aria-label="Open profile menu">Menu</summary>
                    <div class="profile-menu-panel">
                      <div>
                        <div class="eyebrow">Signed in as</div>
                        <div class="profile-name"><%= Current.user.display_name %></div>
                        <div class="profile-email"><%= Current.user.email_address %></div>
                        <span class="theme-chip <%= premium_access? ? 'is-live' : '' %>">Tier: <%= Current.user.account_tier.humanize %></span>
                      </div>

                      <hr>

                      <%= form_with model: Current.user, url: profile_path, method: :patch, class: "stack-sm" do |f| %>
                        <div class="field">
                          <%= f.label :nickname, "Nickname", class: "label" %>
                          <%= f.text_field :nickname, maxlength: 20, placeholder: "Set your nickname", class: "input theme-form-input mono" %>
                        </div>
                        <%= f.submit "Save nickname", class: "button is-small theme-btn-primary is-fullwidth mono" %>
                      <% end %>

                      <hr>

                      <% if premium_access? %>
                        <%= link_to "Dart setup", edit_dart_setup_path, class: "button is-small theme-btn-primary is-fullwidth mono" %>
                      <% else %>
                        <p class="help-theme">Premium: dart setup customization locked.</p>
                      <% end %>
                      <%= link_to "Upgrade", billing_path, class: "button is-small theme-btn-outline is-fullwidth mono mt-2" %>

                      <hr>

                      <%= button_to "Logout", session_path,
                            method: :delete,
                            class: "button is-small theme-btn-outline is-fullwidth mono",
                            form: {
                              onsubmit: "localStorage.removeItem('dartz_player1');localStorage.removeItem('dartz_player2');localStorage.removeItem('dartz_players');localStorage.removeItem('dartz_matches');"
                            } %>
                    </div>
                  </details>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="section app-main">
      <div class="container is-max-widescreen">
        <% if notice %>
          <div class="notification theme-notification is-success-light mono">✓ <%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="notification theme-notification is-danger-light mono">! <%= alert %></div>
        <% end %>

        <%= yield %>
      </div>
    </main>

    <footer class="app-footer">
      <div class="container is-max-widescreen is-flex is-justify-content-space-between is-align-items-center is-flex-wrap-wrap">
        <span class="footer-brand"><%= theme_app_name %></span>
        <div class="footer-links">
          <%= link_to "Privacy", privacy_policy_path %>
          <%= link_to "Terms", terms_of_service_path %>
          <%= link_to "Contact", contact_page_path %>
        </div>
      </div>
    </footer>
  </div>
</body>
</html>
