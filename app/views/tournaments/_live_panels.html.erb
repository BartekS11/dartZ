<% playoff_rounds = tournament.rounds.where(stage_type: "playoffs").order(:number, :created_at) %>
<% upper_rounds = playoff_rounds.select { |round| round.bracket == "upper" } %>
<% lower_rounds = playoff_rounds.select { |round| round.bracket == "lower" } %>
<% final_rounds = playoff_rounds.select { |round| round.bracket == "final" || round.bracket.blank? } %>
<% bronze_rounds = playoff_rounds.select { |round| round.bracket == "bronze" } %>
<% grouped_entries = tournament.entries.to_a.sort_by { |entry| [entry.group_name.to_s, entry.seed || 999999, entry.name.downcase] }.group_by { |entry| entry.group_name.presence || t("tournaments.unassigned_group") } %>

<div id="tournament-live-panels" class="tournament-board grid gap-6 xl:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
  <section class="space-y-4 tournament-column tournament-players-column">
    <div class="theme-card counter-list-card p-4 md:p-5">
      <div class="mb-3 flex items-center justify-between gap-3 tournament-section-head">
        <div>
          <div class="theme-section-label mono mb-1">01</div>
          <h2 class="bebas text-2xl leading-none"><%= t("tournaments.players_standings") %></h2>
        </div>
        <% if can_admin %>
          <div class="flex flex-wrap gap-2">
            <% if tournament.status == "draft" %>
              <%= button_to t("tournaments.start_tournament"), start_tournament_path(tournament, admin_token: admin_token), method: :post, form: { data: { turbo: false } }, class: "btn btn-sm theme-btn-primary rounded-pill mono" %>
            <% end %>
            <%= button_to t("tournaments.regenerate"), regenerate_tournament_path(tournament, admin_token: admin_token), method: :post, form: { data: { turbo: false } }, class: "btn btn-sm theme-btn-outline rounded-pill mono" %>
            <%= button_to t("tournaments.reseed"), reseed_tournament_path(tournament, admin_token: admin_token), method: :post, form: { data: { turbo: false } }, class: "btn btn-sm theme-btn-outline rounded-pill mono" %>
            <% if tournament.format_type == 'swiss' && tournament.manual_advance_allowed? && tournament.can_generate_next_swiss_round? %>
              <%= button_to t("tournaments.next_swiss_round"), advance_round_tournament_path(tournament, admin_token: admin_token), method: :post, class: "btn btn-sm theme-btn-primary rounded-pill mono" %>
            <% end %>
            <% if tournament.format_type == 'playoffs' && tournament.manual_advance_allowed? %>
              <%= button_to t("tournaments.advance_bracket"), advance_round_tournament_path(tournament, admin_token: admin_token), method: :post, class: "btn btn-sm theme-btn-primary rounded-pill mono" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if tournament.group_stage_enabled? && grouped_entries.any? %>
        <div class="tournament-group-overview mb-4">
          <% grouped_entries.each do |group_name, entries| %>
            <div class="tournament-group-card">
              <div class="flex items-center justify-between gap-3">
                <div class="bebas text-xl"><%= group_name == t("tournaments.unassigned_group") ? group_name : t("tournaments.group", name: group_name) %></div>
                <span class="theme-chip mono"><%= t("tournaments.players", count: entries.size) %></span>
              </div>
              <div class="mt-3 grid gap-2">
                <% entries.each do |entry| %>
                  <div class="tournament-group-player mono"><span>#<%= entry.seed || "–" %></span><strong><%= entry.name %></strong></div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if tournament.status == "draft" && can_admin %>
        <div class="theme-blank-slate text-sm mb-4"><%= t("tournaments.draft_help") %></div>
      <% end %>

      <div class="grid gap-2">
        <% tournament.standings.each_with_index do |entry, idx| %>
          <div class="counter-standings-row tournament-player-row">
            <div class="flex items-center justify-between gap-3">
              <div class="flex min-w-0 items-center gap-3">
                <span class="tournament-rank mono">#<%= idx + 1 %></span>
                <div class="min-w-0">
                  <% if entry.group_name.present? %><div class="mono text-xs" style="color:var(--theme-subtle)"><%= t("tournaments.group", name: entry.group_name) %></div><% end %>
                  <div class="tournament-player-name"><%= entry.name %></div>
                </div>
              </div>
              <div class="tournament-player-stats text-right text-sm" style="color:var(--theme-muted)">
                <div><strong><%= entry.wins %></strong>W · <strong><%= entry.losses %></strong>L</div>
                <div><%= t("tournaments.leg_diff", diff: entry.leg_difference) %></div>
                <% if tournament.format_type == "swiss" %><div><%= t("tournaments.buchholz", value: entry.buchholz) %></div><% end %>
              </div>
            </div>
            <% if can_admin %>
              <div class="mt-3 grid gap-2 sm:grid-cols-[minmax(0,1fr)_6rem_7rem_auto]">
                <%= form_with model: entry, url: tournament_entry_path(tournament, entry, admin_token: admin_token), method: :patch, class: "contents" do |f| %>
                  <%= f.text_field :name, class: "form-control theme-form-input", placeholder: t("tournaments.player_name") %>
                  <%= f.number_field :seed, min: 1, class: "form-control theme-form-input", placeholder: t("tournaments.seed") %>
                  <%= f.text_field :group_name, maxlength: 8, class: "form-control theme-form-input", placeholder: t("tournaments.group_name") %>
                  <%= f.submit t("common.save"), class: "btn theme-btn-outline rounded-pill mono" %>
                <% end %>
              </div>
              <div class="mt-2 flex justify-end">
                <%= button_to t("tournaments.remove"), tournament_entry_path(tournament, entry, admin_token: admin_token), method: :delete, class: "btn btn-sm theme-btn-outline rounded-pill mono" %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <section class="space-y-4 tournament-column tournament-matches-column">
    <% if tournament.format_type == "playoffs" %>
      <div class="theme-card counter-list-card p-4 md:p-5">
        <div class="mb-4 tournament-section-head">
          <div class="theme-section-label mono mb-1">02</div>
          <h2 class="bebas text-2xl leading-none"><%= t("tournaments.bracket_matches") %></h2>
        </div>

        <% if upper_rounds.any? %>
          <div class="space-y-5">
            <div class="bracket-scroll">
              <div class="bracket-board bracket-upper">
                <% upper_rounds.each_with_index do |round, index| %>
                  <div class="bracket-column <%= 'bracket-column-linked' if index.positive? %>">
                    <div class="bracket-column-title mono"><%= round.name %></div>
                    <div class="bracket-round-card">
                      <div class="grid gap-3">
                        <% round.tournament_matches.order(:position).each do |match| %>
                          <%= render "tournaments/match_card", match: match, tournament: tournament, can_admin: can_admin, admin_token: admin_token, bracket: true %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <% if lower_rounds.any? %>
              <div>
                <div class="mono mb-3 text-xs uppercase tracking-[0.16em]" style="color:var(--theme-warning)"><%= t("tournaments.lower_bracket") %></div>
                <div class="bracket-scroll">
                  <div class="bracket-board bracket-lower">
                    <% lower_rounds.each_with_index do |round, index| %>
                      <div class="bracket-column <%= 'bracket-column-linked' if index.positive? %>">
                        <div class="bracket-column-title mono"><%= round.name %></div>
                        <div class="bracket-round-card">
                          <div class="grid gap-3">
                            <% round.tournament_matches.order(:position).each do |match| %>
                              <%= render "tournaments/match_card", match: match, tournament: tournament, can_admin: can_admin, admin_token: admin_token, bracket: true %>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <% if final_rounds.any? %>
              <div>
                <div class="mono mb-3 text-xs uppercase tracking-[0.16em]" style="color:var(--theme-success)"><%= t("tournaments.final") %></div>
                <div class="bracket-scroll">
                  <div class="bracket-board bracket-final">
                    <% final_rounds.each_with_index do |round, index| %>
                      <div class="bracket-column <%= 'bracket-column-linked' if index.positive? %>">
                        <div class="bracket-column-title mono"><%= round.name %></div>
                        <div class="bracket-round-card">
                          <div class="grid gap-3">
                            <% round.tournament_matches.order(:position).each do |match| %>
                              <%= render "tournaments/match_card", match: match, tournament: tournament, can_admin: can_admin, admin_token: admin_token, bracket: true %>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>

            <% if bronze_rounds.any? %>
              <div>
                <div class="mono mb-3 text-xs uppercase tracking-[0.16em] text-orange-300"><%= t("tournaments.bronze") %></div>
                <div class="bracket-scroll">
                  <div class="bracket-board bracket-bronze">
                    <% bronze_rounds.each_with_index do |round, index| %>
                      <div class="bracket-column <%= 'bracket-column-linked' if index.positive? %>">
                        <div class="bracket-column-title mono"><%= round.name %></div>
                        <div class="bracket-round-card">
                          <div class="grid gap-3">
                            <% round.tournament_matches.order(:position).each do |match| %>
                              <%= render "tournaments/match_card", match: match, tournament: tournament, can_admin: can_admin, admin_token: admin_token, bracket: true %>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="theme-blank-slate text-sm"><%= t("tournaments.bracket_empty") %></div>
        <% end %>
      </div>
    <% else %>
      <% if tournament.status == "draft" %>
        <div class="theme-card counter-list-card p-4 md:p-5">
          <div class="mb-3 tournament-section-head">
            <div class="theme-section-label mono mb-1">02</div>
            <h2 class="bebas text-2xl leading-none"><%= t("tournaments.ready_to_start") %></h2>
          </div>
          <p class="text-sm" style="color:var(--theme-muted)"><%= t("tournaments.ready_to_start_copy") %></p>
          <% if can_admin %>
            <div class="mt-4 flex flex-wrap gap-2">
              <%= button_to t("tournaments.start_tournament"), start_tournament_path(tournament, admin_token: admin_token), method: :post, form: { data: { turbo: false } }, class: "btn theme-btn-primary rounded-pill mono" %>
              <%= button_to t("tournaments.auto_assign_groups"), regenerate_tournament_path(tournament, admin_token: admin_token), method: :post, form: { data: { turbo: false } }, class: "btn theme-btn-outline rounded-pill mono" %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% tournament.rounds.order(:number).each do |round| %>
        <div class="theme-card counter-list-card p-4 md:p-5">
          <div class="mb-3 tournament-section-head">
            <div class="theme-section-label mono mb-1"><%= round.stage_type %></div>
            <h2 class="bebas text-2xl leading-none"><%= round.name %></h2>
          </div>
          <div class="grid gap-3">
            <% round.tournament_matches.order(:position).each do |match| %>
              <%= render "tournaments/match_card", match: match, tournament: tournament, can_admin: can_admin, admin_token: admin_token %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
