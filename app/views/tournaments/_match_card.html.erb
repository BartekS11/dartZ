<div class="counter-standings-row tournament-match-row <%= local_assigns[:bracket] ? 'bracket-match-card' : '' %>">
  <div class="tournament-match-main">
    <div class="min-w-0 tournament-match-content">
      <% home_winner = match.status == "complete" && match.winner_entry == match.home_entry %>
      <% away_winner = match.status == "complete" && match.winner_entry == match.away_entry %>
      <% live_presenter = TournamentMatchLivePresenter.new(match) %>

      <div class="tournament-match-teams">
        <div class="tournament-match-team <%= 'is-winner' if home_winner %>">
          <span class="tournament-team-side mono"><%= t("tournaments.home", default: "Home") %></span>
          <strong><%= match.home_entry&.name || t("tournaments.tbd") %></strong>
        </div>
        <div class="tournament-match-vs mono"><%= t("tournaments.vs") %></div>
        <div class="tournament-match-team <%= 'is-winner' if away_winner %>">
          <span class="tournament-team-side mono"><%= t("tournaments.away", default: "Away") %></span>
          <strong><%= match.away_entry&.name || t("tournaments.tbd") %></strong>
        </div>
      </div>

      <div class="tournament-match-meta-row">
        <span class="tournament-status mono tournament-status-<%= match.status %>"><%= match.status %><%= match.bye ? " · #{t('tournaments.bye')}" : "" %></span>
        <% match.game_mode_labels.each do |label| %>
          <span class="theme-chip mono"><%= label %></span>
        <% end %>
      </div>

      <div class="tournament-result-line tournament-result-box">
        <% if match.status == "complete" %>
          <% if match.best_of_sets > 1 %>
            <span><%= t("live_match.sets") %> <strong style="color:<%= home_winner ? 'var(--theme-success)' : 'var(--theme-muted)' %>"><%= match.home_sets %></strong>-<strong style="color:<%= away_winner ? 'var(--theme-success)' : 'var(--theme-muted)' %>"><%= match.away_sets %></strong></span>
            <span class="tournament-result-separator"></span>
            <span><%= t("live_match.legs") %> <strong style="color:<%= home_winner ? 'var(--theme-success)' : 'var(--theme-muted)' %>"><%= match.home_legs %></strong>-<strong style="color:<%= away_winner ? 'var(--theme-success)' : 'var(--theme-muted)' %>"><%= match.away_legs %></strong></span>
          <% else %>
            <span><%= t("live_match.legs") %> <strong style="color:<%= home_winner ? 'var(--theme-success)' : 'var(--theme-muted)' %>"><%= match.home_legs %></strong>-<strong style="color:<%= away_winner ? 'var(--theme-success)' : 'var(--theme-muted)' %>"><%= match.away_legs %></strong></span>
          <% end %>
        <% else %>
          <strong><%= live_presenter.primary_score %></strong>
          <% if live_presenter.secondary_score.present? %>
            <span class="tournament-result-separator"></span>
            <span><%= live_presenter.secondary_score %></span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="flex flex-wrap gap-2 tournament-match-actions">
      <% if can_admin && match.launchable? %>
        <%= button_to t("tournaments.play_match"), launch_tournament_tournament_match_path(tournament, match, admin_token: admin_token), method: :post, form: { data: { turbo: false } }, class: "btn theme-btn-primary rounded-pill mono" %>
      <% elsif match.linked_match.present? %>
        <%= link_to t("tournaments.open_live_match"), match_path(match.linked_match, guest_token: match.linked_match.guest_token), data: { turbo: false }, class: "btn theme-btn-outline rounded-pill mono" %>
      <% end %>
    </div>
  </div>

  <% if can_admin && !match.bye %>
    <%= form_with url: report_tournament_tournament_match_path(tournament, match, admin_token: admin_token), method: :patch, class: "tournament-report-form" do |f| %>
      <label>
        <span><%= t("tournaments.home_sets") %></span>
        <%= number_field_tag :home_sets, match.home_sets, min: 0, class: "form-control theme-form-input", placeholder: t("tournaments.home_sets") %>
      </label>
      <label>
        <span><%= t("tournaments.away_sets") %></span>
        <%= number_field_tag :away_sets, match.away_sets, min: 0, class: "form-control theme-form-input", placeholder: t("tournaments.away_sets") %>
      </label>
      <div class="tournament-report-divider" aria-hidden="true"></div>
      <label>
        <span><%= t("tournaments.home_legs") %></span>
        <%= number_field_tag :home_legs, match.home_legs, min: 0, class: "form-control theme-form-input", placeholder: t("tournaments.home_legs") %>
      </label>
      <label>
        <span><%= t("tournaments.away_legs") %></span>
        <%= number_field_tag :away_legs, match.away_legs, min: 0, class: "form-control theme-form-input", placeholder: t("tournaments.away_legs") %>
      </label>
      <%= f.submit t("common.save"), class: "btn theme-btn-outline rounded-pill mono tournament-report-save" %>
    <% end %>
  <% end %>
</div>
