<div class="rounded-2xl border border-white/5 bg-white/[0.02] p-3 <%= local_assigns[:bracket] ? 'bracket-match-card' : '' %>">
  <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <div>
      <div class="font-semibold text-white"><%= match.label %></div>
      <div class="mono mt-1 text-xs uppercase tracking-[0.16em] text-zinc-500"><%= match.status %><%= ' · bye' if match.bye %></div>
      <% if match.status == "complete" %>
        <div class="mt-2 text-sm text-zinc-300">Sets <%= match.home_sets %>-<%= match.away_sets %> · Legs <%= match.home_legs %>-<%= match.away_legs %></div>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-2">
      <% if can_admin && match.launchable? %>
        <%= button_to "Play match", launch_tournament_tournament_match_path(tournament, match, admin_token: admin_token), method: :post, class: "btn btn-sm theme-btn-primary rounded-pill mono" %>
      <% elsif match.linked_match.present? %>
        <%= link_to "Open live match", match_path(match.linked_match), class: "btn btn-sm theme-btn-outline rounded-pill mono" %>
      <% end %>
    </div>
  </div>

  <% if can_admin && !match.bye %>
    <%= form_with url: report_tournament_tournament_match_path(tournament, match, admin_token: admin_token), method: :patch, class: "mt-3 grid gap-2 md:grid-cols-5" do |f| %>
      <%= number_field_tag :home_sets, match.home_sets, min: 0, class: "form-control theme-form-input", placeholder: "Home sets" %>
      <%= number_field_tag :away_sets, match.away_sets, min: 0, class: "form-control theme-form-input", placeholder: "Away sets" %>
      <%= number_field_tag :home_legs, match.home_legs, min: 0, class: "form-control theme-form-input", placeholder: "Home legs" %>
      <%= number_field_tag :away_legs, match.away_legs, min: 0, class: "form-control theme-form-input", placeholder: "Away legs" %>
      <%= f.submit "Save", class: "btn theme-btn-outline rounded-pill mono" %>
    <% end %>
  <% end %>
</div>
