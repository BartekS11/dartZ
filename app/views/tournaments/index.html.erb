<div class="page-shell space-y-6">
  <div class="theme-hero p-5 md:p-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <div class="theme-section-label mono mb-2">Tournaments</div>
        <h1 class="page-title bebas">Run events like a board-side counter.</h1>
        <p class="page-copy max-w-2xl">Create, join, and manage swiss, group, or playoff tournaments in a darker, simpler layout.</p>
      </div>
      <%= link_to "New tournament", new_tournament_path, class: "btn theme-btn-primary rounded-pill px-4 py-3 bebas text-xl" %>
    </div>
  </div>

  <% if Current.user && @my_tournaments.any? %>
    <section class="space-y-3">
      <div class="counter-section-header">
        <div class="theme-section-label mono">Your events</div>
        <h2 class="section-title bebas">Signed-in tournaments</h2>
        <p class="counter-section-copy">Everything you can manage, reopen, and advance.</p>
      </div>
      <div class="counter-list-grid md:grid-cols-2 xl:grid-cols-3">
        <% @my_tournaments.each do |tournament| %>
          <%= link_to tournament_path(tournament), class: "counter-tournament-card no-underline" do %>
            <div class="auth-label mb-1"><%= tournament.format_type %></div>
            <div class="bebas text-2xl leading-none"><%= tournament.title %></div>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="theme-chip mono"><%= tournament.entries.count %> players</span>
              <span class="theme-chip mono"><%= tournament.status %></span>
            </div>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="space-y-3">
    <div class="counter-section-header">
      <div class="theme-section-label mono">Public events</div>
      <h2 class="section-title bebas">Guest tournaments</h2>
      <p class="counter-section-copy">Open links and guest-created events ready to join.</p>
    </div>
    <div class="counter-list-grid md:grid-cols-2 xl:grid-cols-3">
      <% @guest_tournaments.each do |tournament| %>
        <%= link_to tournament_path(tournament), class: "counter-tournament-card no-underline" do %>
          <div class="auth-label mb-1"><%= tournament.format_type %></div>
          <div class="bebas text-2xl leading-none"><%= tournament.title %></div>
          <div class="mt-3 flex flex-wrap gap-2">
            <span class="theme-chip mono"><%= tournament.entries.count %> players</span>
            <span class="theme-chip mono"><%= tournament.status %></span>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
