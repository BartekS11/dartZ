<div class="page-shell stack-lg">
  <section class="theme-hero p-5">
    <div class="level is-align-items-flex-end">
      <div class="level-left">
        <div>
          <div class="theme-section-label">Tournaments</div>
          <h1 class="page-title">Run events like a board-side counter.</h1>
          <p class="page-copy">Create, join, and manage swiss, group, or playoff tournaments.</p>
        </div>
      </div>
      <div class="level-right"><%= link_to "New tournament", new_tournament_path, class: "button theme-btn-primary is-medium" %></div>
    </div>
  </section>

  <% if Current.user && @my_tournaments.any? %>
    <section class="stack-md">
      <div><div class="theme-section-label">Your events</div><h2 class="section-title">Signed-in tournaments</h2><p class="page-copy">Everything you can manage, reopen, and advance.</p></div>
      <div class="columns is-multiline is-variable is-3">
        <% @my_tournaments.each do |tournament| %>
          <div class="column is-6-tablet is-4-desktop"><%= link_to tournament_path(tournament), class: "counter-tournament-card p-4" do %><div class="auth-label mb-1"><%= tournament.format_type %></div><div class="section-title"><%= tournament.title %></div><div class="is-flex is-flex-wrap-wrap mt-3" style="gap:.45rem"><span class="theme-chip"><%= tournament.entries.count %> players</span><span class="theme-chip"><%= tournament.status %></span></div><% end %></div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="stack-md">
    <div><div class="theme-section-label">Public events</div><h2 class="section-title">Guest tournaments</h2><p class="page-copy">Open links and guest-created events ready to join.</p></div>
    <div class="columns is-multiline is-variable is-3">
      <% @guest_tournaments.each do |tournament| %>
        <div class="column is-6-tablet is-4-desktop"><%= link_to tournament_path(tournament), class: "counter-tournament-card p-4" do %><div class="auth-label mb-1"><%= tournament.format_type %></div><div class="section-title"><%= tournament.title %></div><div class="is-flex is-flex-wrap-wrap mt-3" style="gap:.45rem"><span class="theme-chip"><%= tournament.entries.count %> players</span><span class="theme-chip"><%= tournament.status %></span></div><% end %></div>
      <% end %>
    </div>
  </section>
</div>
