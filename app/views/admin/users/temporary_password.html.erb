<div class="page-shell stack-lg">
  <section class="theme-card p-5 stack-md">
    <h1 class="page-title">Temporary password</h1>
    <p>Account: <%= @user.email_address %></p>
    <code id="temporary-password" data-turbo-temporary><%= @temporary_password %></code>
    <p class="help-theme">Copy this password now and share it securely. It is shown only in this response, not stored in plaintext. Existing sessions have been revoked. The user must choose a different password after signing in.</p>
    <%= link_to "Back to user", admin_user_path(@user), class: "button theme-btn-outline" %>
  </section>
</div>
