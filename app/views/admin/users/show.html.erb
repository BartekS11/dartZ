<div class="page-shell stack-lg">
  <section class="theme-hero p-5">
    <div class="theme-section-label">User #<%= @user.id %></div>
    <h1 class="page-title"><%= @user.display_name %></h1>
    <p class="mono"><%= @user.email_address %></p>
    <div class="buttons mt-4">
      <%= link_to "Browse matches", matches_admin_user_path(@user), class: "button theme-btn-primary mono" %>
      <%= link_to "Back to users", admin_users_path, class: "button theme-btn-outline mono" %>
    </div>
  </section>

  <section class="columns is-multiline is-variable is-3">
    <% { "Matches" => @metrics[:matches], "Completed" => @metrics[:completed], "In progress" => @metrics[:in_progress], "Wins / losses" => "#{@metrics[:wins]} / #{@metrics[:losses]}", "Bot" => @metrics[:bots], "Invited" => @metrics[:invitations], "Tournament" => @metrics[:tournaments], "Last match" => (@metrics[:last_match_at]&.to_date || "—") }.each do |label, value| %>
      <div class="column is-6-tablet is-3-desktop"><div class="theme-card p-4"><div class="auth-label"><%= label %></div><div class="section-title"><%= value %></div></div></div>
    <% end %>
  </section>

  <section class="columns is-variable is-4">
    <div class="column">
      <div class="theme-card p-5 stack-md">
        <h2 class="section-title">Tier control</h2>
        <dl class="mono text-sm stack-sm">
          <div><dt class="auth-label">Stripe-managed tier</dt><dd><%= @user.account_tier.humanize %></dd></div>
          <div><dt class="auth-label">Manual override</dt><dd><%= @user.manual_tier_override&.humanize || "None" %></dd></div>
          <div><dt class="auth-label">Effective tier</dt><dd><strong><%= @user.effective_account_tier.humanize %></strong></dd></div>
        </dl>
        <%= form_with url: tier_admin_user_path(@user), method: :patch, class: "stack-md" do %>
          <div>
            <%= label_tag :manual_tier_override, "Override", class: "auth-label" %>
            <%= select_tag :manual_tier_override, options_for_select([["Use Stripe-managed tier", ""], ["Free", "free"], ["Premium", "premium"], ["Pro", "pro"]], @user.manual_tier_override), class: "input theme-form-input mono" %>
          </div>
          <div>
            <%= label_tag :reason, "Reason / comment", class: "auth-label" %>
            <%= text_area_tag :reason, nil, rows: 3, class: "textarea theme-form-input mono", placeholder: "Required for every effective downgrade" %>
          </div>
          <%= submit_tag "Apply override", class: "button theme-btn-primary mono", data: { turbo_confirm: "Apply this tier override?" } %>
        <% end %>
      </div>
    </div>

    <div class="column">
      <div class="theme-card p-5 stack-md">
        <h2 class="section-title">Stripe state (read-only)</h2>
        <dl class="mono text-sm stack-sm">
          <div><dt class="auth-label">Customer</dt><dd><%= @user.stripe_customer_id.presence || "—" %></dd></div>
          <div><dt class="auth-label">Subscription</dt><dd><%= @user.stripe_subscription_id.presence || "—" %></dd></div>
          <div><dt class="auth-label">Status</dt><dd><%= @user.stripe_subscription_status.presence || "—" %></dd></div>
          <div><dt class="auth-label">Price</dt><dd><%= @user.stripe_price_id.presence || "—" %></dd></div>
          <div><dt class="auth-label">Currency</dt><dd><%= @user.subscription_currency&.upcase || "—" %></dd></div>
          <div><dt class="auth-label">Access expiry</dt><dd><%= @user.premium_access_expires_at || "—" %></dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="theme-card p-5 stack-md">
    <div>
      <div class="theme-section-label">Danger zone</div>
      <h2 class="section-title">Data management</h2>
      <p class="help-theme">Clear eligible account history or configuration without deleting this account, its sessions, billing state, tier overrides, or audit records. Shared matches and tournaments are detached and preserved.</p>
    </div>

    <%= render "data_cleanup_confirmation",
      user: @user,
      form_url: admin_user_data_cleanups_path(@user),
      form_method: :post,
      action_label: "Clear account data",
      final_label: "Yes, clear selected data",
      warning: "Selected data will be hidden from this account and its statistics. Active activity is not affected.",
      second_warning: "This creates one restorable cleanup batch. Continue only if the selected scope is correct.",
      categories: true,
      purge: false %>

    <h3 class="section-title">Cleanup batches</h3>
    <% if @data_cleanups.any? %>
      <div class="stack-md">
        <% @data_cleanups.each do |cleanup| %>
          <article class="theme-panel p-4 stack-sm">
            <div class="is-flex is-justify-content-space-between is-align-items-flex-start">
              <div><strong class="mono"><%= cleanup.public_id %></strong><div class="help-theme"><%= cleanup.created_at %></div></div>
              <span class="theme-chip"><%= cleanup.status.humanize %></span>
            </div>
            <div class="is-flex is-flex-wrap-wrap gap-2">
              <% cleanup.categories.each do |category| %><span class="theme-chip"><%= category.humanize %>: <%= cleanup.counts.fetch(category, 0) %></span><% end %>
            </div>
            <div class="stack-sm">
              <% cleanup.events.each do |event| %>
                <div class="mono text-sm"><strong><%= event.action.humanize %></strong> · <%= event.admin_user.email_address %> · <%= event.created_at %><br><span class="help-theme"><%= event.reason %></span></div>
              <% end %>
            </div>
            <% if cleanup.cleared? %>
              <div class="buttons">
                <%= render "data_cleanup_confirmation",
                  user: @user,
                  form_url: restore_admin_user_data_cleanup_path(@user, cleanup),
                  form_method: :patch,
                  action_label: "Restore batch",
                  final_label: "Yes, restore entire batch",
                  warning: "Every record and association in this batch will be restored together.",
                  second_warning: "Newer dart setup or drill conflicts will reject the entire restore; nothing will be overwritten.",
                  categories: false,
                  purge: false %>
                <%= render "data_cleanup_confirmation",
                  user: @user,
                  form_url: purge_admin_user_data_cleanup_path(@user, cleanup),
                  form_method: :delete,
                  action_label: "Permanently purge",
                  final_label: "Permanently purge entire batch",
                  warning: "This permanently deletes retained account-owned records and makes detached shared-data links unrecoverable.",
                  second_warning: "This action is irreversible. The audit batch and events will remain permanently.",
                  categories: false,
                  purge: true %>
              </div>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="theme-blank-slate">No account data has been cleared by an administrator.</div>
    <% end %>
  </section>

  <section class="theme-card p-5 stack-md">
    <h2 class="section-title">Tier audit history</h2>
    <% if @tier_changes.any? %>
      <div style="overflow-x:auto"><table class="table is-fullwidth mono text-sm">
        <thead><tr><th>Time</th><th>Administrator</th><th>Action</th><th>Override</th><th>Effective tier</th><th>Reason</th></tr></thead>
        <tbody><% @tier_changes.each do |change| %><tr>
          <td><%= change.created_at %></td><td><%= change.admin_user.email_address %></td><td><%= change.action %></td>
          <td><%= change.previous_override || "None" %> → <%= change.new_override || "None" %></td>
          <td><%= change.previous_effective_tier %> → <%= change.new_effective_tier %></td><td><%= change.reason.presence || "—" %></td>
        </tr><% end %></tbody>
      </table></div>
    <% else %><div class="theme-blank-slate">No manual tier changes.</div><% end %>
  </section>
</div>
