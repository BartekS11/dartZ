<%= turbo_stream.replace "score" do %>
  <p id="score"
     data-score-version="<%= SecureRandom.uuid %>"
     class="score-pulse bebas text-6xl font-extrabold tabular-nums"
     style="color:var(--theme-success)">
    <%= @turn.leg_player.score %>
  </p>
<% end %>

<%= turbo_stream.replace "throws" do %>
  <div id="throws" class="mt-2 text-sm" style="color:var(--theme-muted)">
    Last throw:
    <strong><%= @throw.multiplier.capitalize %> <%= @throw.segment %></strong>
    (<%= @throw.points %> pts)
  </div>
<% end %>

<%= turbo_stream.replace "current-player" do %>
  <span id="current-player"
        class="theme-badge-active">

<%= @turn.leg.active_player.display_name %>
  </span>
<% end %>
