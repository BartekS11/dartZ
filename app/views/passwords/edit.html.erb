<div class="page-shell page-shell-compact" style="min-height:70vh; display:grid; place-items:center">
  <div class="stack-md" style="width:min(32rem,100%)">
    <div class="page-header has-text-centered">
      <div class="theme-section-label"><%= t("common.account") %></div>
      <h1 class="page-title"><%= t("auth.reset_password") %></h1>
    </div>

    <div class="auth-card p-5">
      <% if alert = flash[:alert] %><div class="flash-theme alert mono mb-4">⚠ <%= alert %></div><% end %>

      <%= form_with url: password_path(params[:token]), method: :put, class: "stack-md" do |form| %>
        <div class="field">
          <label class="label auth-label"><%= t("common.password") %></label>
          <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: t("auth.password_placeholder"), maxlength: 72, class: "input auth-input" %>
        </div>
        <div class="field">
          <label class="label auth-label"><%= t("common.confirm_password") %></label>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t("auth.repeat_password_placeholder"), maxlength: 72, class: "input auth-input" %>
        </div>
        <%= form.submit t("common.save"), class: "button theme-btn-primary is-fullwidth is-medium" %>
      <% end %>
    </div>
  </div>
</div>
