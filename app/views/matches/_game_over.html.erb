<% presenter ||= MatchStatePresenter.new(match) %>
<% multi_set  = match.best_of_sets > 1 %>
<% multi_leg  = match.best_of_legs > 1 %>
<% total_secs = (match.finished_at - match.created_at).to_i %>
<% total_mins = total_secs / 60 %>
<% total_secs_rem = total_secs % 60 %>

<div class="theme-game-over">
  <svg class="game-over-watermark" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="50" cy="50" r="49" stroke="var(--theme-primary)" stroke-width="0.5" />
    <circle cx="50" cy="50" r="40" stroke="var(--theme-primary)" stroke-width="0.5" />
    <circle cx="50" cy="50" r="30" stroke="var(--theme-primary)" stroke-width="0.5" />
    <circle cx="50" cy="50" r="20" stroke="var(--theme-primary)" stroke-width="0.5" />
    <circle cx="50" cy="50" r="10" stroke="var(--theme-primary)" stroke-width="1" />
    <circle cx="50" cy="50" r="4" fill="var(--theme-primary)" />
  </svg>

  <div class="position-relative">
    <div class="theme-section-label mono mb-2">Game over</div>
    <h1 class="game-over-title bebas mb-4">DART<span class="text-white">Z</span></h1>

    <div class="game-over-winner mb-4">
      <div class="game-over-winner-name bebas text-white mb-2"><%= presenter.winner.display_name %></div>
      <div class="mono text-muted-theme small text-uppercase">
        <% if multi_set %>
          Wins the match
        <% elsif multi_leg %>
          Wins the set
        <% else %>
          Takes the leg
        <% end %>
      </div>
    </div>

    <div class="row g-3 justify-content-center mb-4">
      <% presenter.players.each do |player| %>
        <% is_winner = presenter.winner == player %>
        <div class="col-6 col-md-4">
          <div class="game-over-stat-card h-100">
            <div class="mono text-subtle-theme small text-uppercase mb-2"><%= player.display_name %></div>
            <div class="bebas fs-1 mb-1 <%= is_winner ? 'text-success' : 'text-white' %>">
              <%= multi_set ? presenter.sets_won_by(player) : presenter.legs_won_by(player) %>
            </div>
            <div class="mono text-muted-theme small"><%= presenter.three_dart_average(player) %> avg</div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="row g-3 justify-content-center mb-4">
      <div class="col-12 col-md-4">
        <div class="game-over-stat-card">
          <div class="mono text-subtle-theme small text-uppercase mb-1">Finished at</div>
          <div class="bebas fs-2"><%= match.finished_at.strftime("%H:%M") %></div>
        </div>
      </div>
      <div class="col-12 col-md-4">
        <div class="game-over-stat-card">
          <div class="mono text-subtle-theme small text-uppercase mb-1">Duration</div>
          <div class="bebas fs-2"><%= format("%d:%02d", total_mins, total_secs_rem) %></div>
        </div>
      </div>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-center gap-3">
      <%= link_to "New match", matches_path, class: "btn theme-btn-primary rounded-pill bebas fs-4 px-4" %>
      <%= link_to "Back to matches", matches_path, class: "btn theme-btn-outline rounded-pill mono" %>
    </div>
  </div>
</div>
