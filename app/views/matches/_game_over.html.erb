<% presenter ||= MatchStatePresenter.new(match) %>
<% multi_set  = match.best_of_sets > 1 %>
<% multi_leg  = match.best_of_legs > 1 %>
<% total_secs = (match.finished_at - match.created_at).to_i %>
<% total_mins = total_secs / 60 %>
<% total_secs_rem = total_secs % 60 %>

<div class="theme-game-over mx-auto max-w-5xl">
  <div class="mx-auto max-w-3xl">
    <div class="theme-section-label mono mb-2">Match complete</div>
    <h1 class="game-over-title bebas mb-3">Nice darts.</h1>
    <p class="theme-subtitle mx-auto mb-6 max-w-2xl">A cleaner recap of the result, with the winner and the key numbers front and center.</p>

    <div class="mb-6 rounded-[1.6rem] border border-red-500/20 bg-red-500/10 px-5 py-5">
      <div class="mono mb-2 text-xs uppercase tracking-[0.18em] text-red-300">
        <% if multi_set %>
          Match winner
        <% elsif multi_leg %>
          Set winner
        <% else %>
          Leg winner
        <% end %>
      </div>
      <div class="bebas text-5xl leading-none text-white"><%= presenter.winner.display_name %></div>
    </div>

    <div class="mb-6 grid gap-3 md:grid-cols-2">
      <% presenter.players.each do |player| %>
        <% is_winner = presenter.winner == player %>
        <div class="game-over-stat-card h-full text-left">
          <div class="mono mb-2 text-xs uppercase tracking-[0.16em] text-zinc-500"><%= player.display_name %></div>
          <div class="mb-1 bebas text-4xl leading-none <%= is_winner ? 'text-green-400' : 'text-white' %>">
            <%= multi_set ? presenter.sets_won_by(player) : presenter.legs_won_by(player) %>
          </div>
          <div class="mono text-xs uppercase tracking-[0.16em] text-zinc-500">Legs / sets won</div>
          <div class="mt-3 text-sm text-zinc-300"><span class="bebas mr-2 text-xl align-middle"><%= presenter.three_dart_average(player) %></span> average</div>
        </div>
      <% end %>
    </div>

    <div class="mb-6 grid gap-3 md:grid-cols-2">
      <div class="game-over-stat-card">
        <div class="mono mb-2 text-xs uppercase tracking-[0.16em] text-zinc-500">Finished at</div>
        <div class="bebas text-3xl leading-none"><%= match.finished_at.strftime("%H:%M") %></div>
      </div>
      <div class="game-over-stat-card">
        <div class="mono mb-2 text-xs uppercase tracking-[0.16em] text-zinc-500">Duration</div>
        <div class="bebas text-3xl leading-none"><%= format("%d:%02d", total_mins, total_secs_rem) %></div>
      </div>
    </div>

    <div class="flex flex-col justify-center gap-3 sm:flex-row">
      <%= link_to "New match", matches_path, class: "btn theme-btn-primary rounded-pill px-4 bebas text-xl" %>
      <%= link_to "Back to matches", matches_path, class: "btn theme-btn-outline rounded-pill mono" %>
    </div>
  </div>
</div>
