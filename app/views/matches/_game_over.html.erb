<% presenter ||= MatchStatePresenter.new(match) %>
<% multi_set  = match.best_of_sets > 1 %>
<% multi_leg  = match.best_of_legs > 1 %>
<% total_secs = (match.finished_at - match.created_at).to_i %>
<% total_mins = total_secs / 60 %>
<% total_secs_rem = total_secs % 60 %>

<div class="theme-game-over page-shell page-shell-narrow">
  <div class="mx-auto max-w-3xl">
    <div class="page-header mb-6 text-center">
      <div class="theme-section-label mono">Match complete</div>
      <h1 class="game-over-title bebas">Nice darts.</h1>
      <p class="page-copy mx-auto max-w-2xl">Final result first, the numbers after.</p>
    </div>

    <div class="counter-summary-tile mb-6 px-5 py-5" style="border-color:color-mix(in srgb, var(--theme-primary) 18%, transparent); background:color-mix(in srgb, var(--theme-primary) 8%, transparent)">
      <div class="mono mb-2 text-xs uppercase tracking-[0.18em]" style="color:var(--theme-primary-soft)">
        <% if multi_set %>
          Match winner
        <% elsif multi_leg %>
          Set winner
        <% else %>
          Leg winner
        <% end %>
      </div>
      <div class="bebas text-5xl leading-none"><%= presenter.winner.display_name %></div>
    </div>

    <div class="mb-6 grid gap-3 md:grid-cols-2">
      <% presenter.players.each do |player| %>
        <% is_winner = presenter.winner == player %>
        <div class="game-over-stat-card counter-list-card h-full text-left">
          <div class="auth-label mb-2"><%= player.display_name %></div>
          <div class="mb-1 bebas text-4xl leading-none" style="color:<%= is_winner ? 'var(--theme-success)' : 'var(--theme-text)' %>">
            <%= multi_set ? presenter.sets_won_by(player) : presenter.legs_won_by(player) %>
          </div>
          <div class="auth-label">Legs / sets won</div>
          <div class="mt-3 text-sm"><span class="bebas mr-2 text-xl align-middle"><%= presenter.three_dart_average(player) %></span>average</div>
        </div>
      <% end %>
    </div>

    <div class="mb-6 grid gap-3 md:grid-cols-2">
      <div class="game-over-stat-card counter-list-card">
        <div class="auth-label mb-2">Finished at</div>
        <div class="bebas text-3xl leading-none"><%= match.finished_at.strftime("%H:%M") %></div>
      </div>
      <div class="game-over-stat-card counter-list-card">
        <div class="auth-label mb-2">Duration</div>
        <div class="bebas text-3xl leading-none"><%= format("%d:%02d", total_mins, total_secs_rem) %></div>
      </div>
    </div>

    <div class="flex flex-col justify-center gap-3 sm:flex-row">
      <%= link_to "New match", matches_path, class: "btn theme-btn-primary rounded-pill px-4 py-3 bebas text-xl" %>
      <%= link_to "Back to matches", matches_path, class: "btn theme-btn-outline rounded-pill mono" %>
    </div>
  </div>
</div>
