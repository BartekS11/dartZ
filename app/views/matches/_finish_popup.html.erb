<% match      = leg.match %>
<% multi_set  = match.best_of_sets > 1 %>
<% multi_leg  = match.best_of_legs > 1 %>
<% set_winner = multi_set && leg.match_set.finished? && leg.match_set.winner == player %>
<% match_won  = match.finished? && match.winner == player %>
<% popup_class = match_won ? 'is-match' : set_winner ? 'is-set' : 'is-leg' %>
<% accent_color = match_won ? 'var(--theme-primary-soft)' : set_winner ? 'var(--theme-warning)' : 'var(--theme-success)' %>

<div id="finish-popup-overlay" class="finish-popup-overlay">
  <div class="finish-popup-card <%= popup_class %>">
    <div class="mb-5 text-center">
      <p class="mono mb-2 text-[0.68rem] uppercase tracking-[0.2em]" style="color:<%= accent_color %>">
        <% if match_won %>
          Match won
        <% elsif set_winner %>
          Set won
        <% else %>
          Checkout complete
        <% end %>
      </p>

      <p class="bebas text-4xl leading-none"><%= player.display_name %></p>
      <p class="mono mt-2 text-xs uppercase tracking-[0.16em]" style="color:var(--theme-subtle)">
        <% if match_won %>
          wins the match
        <% elsif set_winner %>
          wins the set
        <% else %>
          wins the leg
        <% end %>
      </p>
    </div>

    <% unless leg.checkout_throws.present? %>
      <form action="<%= leg_checkout_path(leg) %>" method="post" id="checkout-form" data-turbo="false">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

        <div class="mb-4">
          <p class="mono mb-3 text-center text-[0.68rem] uppercase tracking-[0.16em]" style="color:var(--theme-subtle)">
            How many darts were needed to finish?
          </p>

          <div class="grid grid-cols-3 gap-3">
            <% [1, 2, 3].each do |n| %>
              <label class="checkout-choice">
                <input type="radio"
                       name="checkout_throws"
                       value="<%= n %>"
                       required
                       class="absolute opacity-0 pointer-events-none"
                       onchange="document.querySelectorAll('#checkout-form .checkout-choice').forEach(el => el.classList.remove('active')); this.closest('.checkout-choice').classList.add('active');">
                <span><%= n %></span>
              </label>
            <% end %>
          </div>
        </div>

        <button type="submit" class="btn theme-btn-primary w-100 rounded-pill px-4 py-3 bebas text-xl">
          <%= match_won ? 'See results →' : 'Next leg →' %>
        </button>
      </form>
    <% else %>
      <button type="button"
              onclick="this.closest('#finish-popup-overlay').style.display='none'"
              class="btn theme-btn-primary w-100 rounded-pill px-4 py-3 bebas text-xl">
        <%= match_won ? 'See results →' : 'Continue →' %>
      </button>
    <% end %>
  </div>
</div>
