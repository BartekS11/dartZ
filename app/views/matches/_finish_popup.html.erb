<% match      = leg.match %>
<% multi_set  = match.best_of_sets > 1 %>
<% multi_leg  = match.best_of_legs > 1 %>
<% set_winner = multi_set && leg.match_set.finished? && leg.match_set.winner == player %>
<% match_won  = match.finished? && match.winner == player %>
<% popup_class = match_won ? 'is-match' : set_winner ? 'is-set' : 'is-leg' %>
<% accent_color = match_won ? 'var(--theme-primary-soft)' : set_winner ? 'var(--theme-warning)' : 'var(--theme-success)' %>
<% checkout_turn = leg.turns.includes(:throws).where(player: player).order(:created_at).last %>
<% checkout_score = checkout_turn&.throws&.sum(&:points).to_i %>
<% minimum_checkout_darts = CheckoutCalculator.darts_needed(checkout_score, double_out: match.double_out?) %>

<div id="finish-popup-overlay" class="finish-popup-overlay" data-winner-player-id="<%= player.id %>">
  <div class="finish-popup-card <%= popup_class %>">
    <div class="mb-5 text-center">
      <p class="mono mb-2 text-[0.68rem] uppercase tracking-[0.2em]" style="color:<%= accent_color %>">
        <% if match_won %>
          <%= t("live_match.match_won") %>
        <% elsif set_winner %>
          <%= t("live_match.set_won") %>
        <% else %>
          <%= t("live_match.checkout_complete") %>
        <% end %>
      </p>

      <p class="bebas text-4xl leading-none"><%= player.display_name %></p>
      <p class="mono mt-2 text-xs uppercase tracking-[0.16em]" style="color:var(--theme-subtle)">
        <% if match_won %>
          <%= t("live_match.wins_match") %>
        <% elsif set_winner %>
          <%= t("live_match.wins_set") %>
        <% else %>
          <%= t("live_match.wins_leg") %>
        <% end %>
      </p>
    </div>

    <% unless leg.checkout_throws.present? %>
      <form action="<%= leg_checkout_path(leg) %>" method="post" id="checkout-form" data-turbo="false" onsubmit="this.querySelector('input[name=authenticity_token]').value = document.querySelector('meta[name=csrf-token]')?.content || this.querySelector('input[name=authenticity_token]').value">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

        <div class="mb-4">
          <p class="mono mb-3 text-center text-[0.68rem] uppercase tracking-[0.16em]" style="color:var(--theme-subtle)">
            <%= t("live_match.darts_needed_question") %>
          </p>

          <div class="grid grid-cols-3 gap-3">
            <% [1, 2, 3].each do |n| %>
              <% possible = CheckoutCalculator.possible_checkout_darts?(checkout_score, n, double_out: match.double_out?) %>
              <label class="checkout-choice <%= 'is-disabled' unless possible %>" title="<%= possible ? '' : t(n == 1 ? 'live_match.cannot_finish' : 'live_match.cannot_finish_plural', score: checkout_score, count: n) %>">
                <input type="radio"
                       name="checkout_throws"
                       value="<%= n %>"
                       required
                       <%= 'disabled' unless possible %>
                       class="absolute opacity-0 pointer-events-none"
                       onchange="document.querySelectorAll('#checkout-form .checkout-choice').forEach(el => el.classList.remove('active')); this.closest('.checkout-choice').classList.add('active');">
                <span><%= n %></span>
              </label>
            <% end %>
          </div>
          <% if minimum_checkout_darts.present? %>
            <p class="mono mt-2 text-center text-[0.62rem] uppercase tracking-[0.12em]" style="color:var(--theme-muted)">
              <%= t(minimum_checkout_darts == 1 ? 'live_match.checkout_needs' : 'live_match.checkout_needs_plural', score: checkout_score, count: minimum_checkout_darts) %>
            </p>
          <% end %>
        </div>

        <button type="submit" class="btn theme-btn-primary w-full rounded-pill px-4 py-3 bebas text-xl">
          <%= match_won ? t("live_match.see_results") : t("live_match.next_leg") %>
        </button>
      </form>
    <% else %>
      <button type="button"
              onclick="this.closest('#finish-popup-overlay').style.display='none'"
              class="btn theme-btn-primary w-full rounded-pill px-4 py-3 bebas text-xl">
        <%= match_won ? t("live_match.see_results") : t("live_match.continue") %>
      </button>
    <% end %>
  </div>
</div>
