<% match      = leg.match %>
<% multi_set  = match.best_of_sets > 1 %>
<% multi_leg  = match.best_of_legs > 1 %>
<% set_winner = multi_set && leg.match_set.finished? && leg.match_set.winner == player %>
<% match_won  = match.finished? && match.winner == player %>

<div id="finish-popup-overlay"
     style="position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:100;
            display:flex;align-items:center;justify-content:center;
            backdrop-filter:blur(4px)">

  <div style="background:#111;border:1px solid #2a2a2a;
              border-top:2px solid <%= match_won ? '#ef4444' : set_winner ? '#f59e0b' : '#22c55e' %>;
              border-radius:16px;padding:2rem;max-width:420px;width:92%;
              box-shadow:0 0 60px rgba(<%= match_won ? '220,38,38' : set_winner ? '245,158,11' : '34,197,94' %>,0.15)">

    <div class="text-center mb-5">
      <p style="font-family:'DM Mono',monospace;font-size:0.6rem;letter-spacing:0.2em;
                color:<%= match_won ? '#ef4444' : set_winner ? '#f59e0b' : '#16a34a' %>;
                text-transform:uppercase;margin-bottom:8px">
        <% if match_won %>
          🏆 Match Won
        <% elsif set_winner %>
          Set Won
        <% else %>
          🎯 Checkout
        <% end %>
      </p>

      <p style="font-family:'Bebas Neue',sans-serif;font-size:2.5rem;line-height:1;
                color:<%= match_won ? '#ef4444' : set_winner ? '#f59e0b' : '#4ade80' %>;
                letter-spacing:0.05em">
        <%= player.display_name %>
      </p>

      <p style="font-family:'DM Mono',monospace;font-size:0.7rem;color:#555;margin-top:4px">
        <% if match_won %>
          wins the match
        <% elsif set_winner %>
          wins the set
        <% else %>
          wins the leg
        <% end %>
      </p>
    </div>

    <% unless leg.checkout_throws.present? %>
      <form action="<%= leg_checkout_path(leg) %>" method="post" id="checkout-form">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

        <div class="mb-4">
          <p style="font-family:'DM Mono',monospace;font-size:0.65rem;letter-spacing:0.15em;
                    color:#444;text-transform:uppercase;margin-bottom:12px;text-align:center">
            How many darts were needed to finish?
          </p>

          <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;">
            <% [1, 2, 3].each do |n| %>
              <label class="checkout-choice" style="cursor:pointer;display:block;">
                <input type="radio"
                       name="checkout_throws"
                       value="<%= n %>"
                       required
                       style="position:absolute;opacity:0;pointer-events:none;"
                       onchange="document.querySelectorAll('#checkout-form .checkout-choice').forEach(el => el.classList.remove('active')); this.closest('.checkout-choice').classList.add('active');">
                <span style="display:block;text-align:center;padding:14px 8px;border-radius:10px;
                             border:1px solid #2a2a2a;background:#0a0a0a;color:#666;
                             font-family:'Bebas Neue',sans-serif;font-size:1.6rem;transition:all 0.15s ease;">
                  <%= n %>
                </span>
              </label>
            <% end %>
          </div>

          <style>
            .checkout-choice.active span {
              background:#052e16 !important;
              border-color:#16a34a !important;
              color:#4ade80 !important;
            }
          </style>
        </div>

        <button type="submit"
                style="width:100%;font-family:'Bebas Neue',sans-serif;font-size:1rem;
                       letter-spacing:0.1em;background:#16a34a;color:white;
                       border:1px solid #22c55e;border-radius:8px;padding:12px;cursor:pointer;">
          <%= match_won ? 'See Results →' : 'Next Leg →' %>
        </button>
      </form>
    <% else %>
      <button type="button"
              onclick="this.closest('#finish-popup-overlay').style.display='none'"
              style="width:100%;font-family:'Bebas Neue',sans-serif;font-size:1rem;
                     letter-spacing:0.1em;background:#dc2626;color:white;
                     border:1px solid #ef4444;border-radius:8px;padding:12px;cursor:pointer">
        <%= match_won ? 'See Results →' : 'Continue →' %>
      </button>
    <% end %>
  </div>
</div>
