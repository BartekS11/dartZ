<% presenter ||= MatchStatePresenter.new(match) %>
<% is_active    = player == presenter.current_player %>
<% score        = presenter.score_for(player) %>
<% sets_won     = presenter.sets_won_by(player) %>
<% legs_won     = presenter.legs_won_by(player) %>
<% multi_set    = match.best_of_sets > 1 %>
<% multi_leg    = match.best_of_legs > 1 %>
<% darts_thrown = is_active ? presenter.current_turn&.throws&.size.to_i : 0 %>
<% suggestion   = match.double_out? ? CheckoutCalculator.suggest(score, darts_remaining: 3 - darts_thrown) : [] %>
<% last_throw_total = presenter.last_turn_total_for(player) %>

<div id="score-card-<%= player.id %>" class="match-score-card <%= 'is-active' if is_active %>">
  <div class="match-score-name-row">
    <span class="match-score-name"><%= player.display_name %></span>
    <% if is_active %><span class="throwing-indicator"><%= t("live_match.throwing") %></span><% end %>
    <% if presenter.needs_double_in?(player) %><span class="theme-chip"><%= t("common.double_in") %></span><% end %>
  </div>

  <div class="match-score-main-row">
    <div id="player-<%= player.id %>-score" class="match-score-number <%= 'is-active' if is_active %>"><%= score %></div>
    <% if last_throw_total.present? %>
      <div class="match-last-throw-pill">
        <span><%= t("live_match.last_throw") %></span>
        <strong><%= last_throw_total %></strong>
      </div>
    <% end %>
  </div>

  <div class="match-score-meta <%= 'has-leg-set-score' if multi_set || multi_leg %>">
    <% if multi_set %>
      <span class="match-progress-pill"><%= t("live_match.sets") %> <strong><%= sets_won %></strong></span>
    <% end %>
    <% if multi_leg %>
      <span class="match-progress-pill"><%= t("live_match.legs") %> <strong><%= legs_won %></strong></span>
    <% end %>
    <% if suggestion.present? %>
      <span class="match-checkout-line"><%= suggestion.first(3).join(" · ") %></span>
    <% end %>
  </div>
</div>
