<% content_for :mobile_header_action do %>
  <%= link_to "← Back", matches_path, class: "btn btn-sm theme-btn-outline rounded-pill mono px-3" %>
<% end %>

<%= turbo_stream_from "match_#{@match.id}" %>

<script>
  (function() {
    const matches = JSON.parse(localStorage.getItem("dartz_matches") || "[]")
    const id = <%= @match.id.to_json %>
    const exists = matches.find(m => m.id === id)
    const guestToken = <%= (Current.user ? nil : @match.guest_token).to_json.html_safe %>
    if (!exists) {
      matches.unshift({
        id: id,
        player1: <%= @match.players.first&.display_name.to_json.html_safe %>,
        player2: <%= @match.players.second&.display_name.to_json.html_safe %>,
        guestToken: guestToken,
        createdAt: <%= @match.created_at.iso8601.to_json.html_safe %>
      })
      localStorage.setItem("dartz_matches", JSON.stringify(matches.slice(0, 10)))
    } else if (guestToken && !exists.guestToken) {
      exists.guestToken = guestToken
      localStorage.setItem("dartz_matches", JSON.stringify(matches.slice(0, 10)))
    }
  })()
</script>

<div id="finish-popup">
  <% if @match.finished? %>
    <% finishing_leg = @match.match_sets.flat_map(&:legs).max_by(&:created_at) %>
    <% finishing_player = finishing_leg&.winner %>
    <% if finishing_player && finishing_leg.checkout_throws.blank? %>
      <%= render "matches/finish_popup", player: finishing_player, leg: finishing_leg %>
    <% end %>
  <% end %>
</div>

<div class="page-shell space-y-4" data-controller="match-view">
  <div id="game-over-section">
    <% if @match.finished? %>
      <%= render "matches/game_over", match: @match, presenter: @presenter %>
    <% end %>
  </div>

  <div id="header-section" class="hidden md:block">
    <% unless @match.finished? %>
      <section class="theme-hero counter-topbar p-4 md:p-5">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
          <div class="space-y-3">
            <div class="flex flex-wrap items-center gap-2">
              <%= link_to "← Back", matches_path, class: "btn btn-sm theme-btn-outline rounded-pill mono hidden md:inline-flex" %>
              <span class="theme-chip mono is-live">Live match</span>
              <% @match.game_mode_labels.each do |label| %>
                <span class="theme-chip mono"><%= label %></span>
              <% end %>
              <% if @match.best_of_sets > 1 %>
                <span class="theme-chip mono">Bo<%= @match.best_of_sets %> sets</span>
              <% end %>
              <span class="theme-chip mono">Bo<%= @match.best_of_legs %> legs</span>
            </div>
            <h1 class="page-title bebas"><%= @match.ui_identifier %></h1>
            <p class="page-copy mb-0 text-sm"><%= @match.players.map(&:display_name).join(" vs ") %></p>
          </div>

          <div class="counter-summary-grid sm:grid-cols-2 lg:min-w-[22rem]">
            <div class="counter-summary-tile">
              <div class="auth-label mb-1">Started</div>
              <div class="text-sm"><%= @match.created_at.strftime("%d %b %Y · %H:%M") %></div>
            </div>
            <div class="counter-summary-tile">
              <div class="auth-label mb-1">Status</div>
              <div class="text-sm">In progress</div>
            </div>
          </div>
        </div>
      </section>
    <% end %>
  </div>

  <div id="score-cards-section">
    <% unless @match.finished? %>
      <section class="grid gap-3 md:grid-cols-2">
        <% @presenter.players.each do |player| %>
          <%= render "matches/score_card", match: @match, presenter: @presenter, player: player %>
        <% end %>
      </section>
    <% end %>
  </div>

  <div id="keyboard-section">
    <% unless @match.finished? %>
      <section class="grid gap-3 md:gap-4 xl:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] xl:items-start">
        <div data-match-view-target="input">
          <div class="theme-card counter-input-card p-4 md:p-5">
            <div id="current-player">
              <%= render "matches/current_player", match: @match, presenter: @presenter, turn: @turn %>
            </div>
          </div>
        </div>

        <div data-match-view-target="pad">
          <%= render "matches/dart_board", match: @match, turn: @turn %>
        </div>
      </section>
    <% end %>
  </div>
</div>
