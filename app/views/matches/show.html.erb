<%= turbo_stream_from "match_#{@match.id}" %>

<div id="finish-popup">
  <% if @match.finished? %>
    <% finishing_leg = @match.match_sets.flat_map(&:legs).max_by(&:created_at) %>
    <% finishing_player = finishing_leg&.winner %>
    <% if finishing_player && finishing_leg.checkout_throws.blank? && (!@match.invite_match? || @current_match_player == finishing_player) %>
      <%= render "matches/finish_popup", player: finishing_player, leg: finishing_leg %>
    <% end %>
  <% end %>
</div>

<%= render "matches/live",
      match: @match,
      presenter: @presenter,
      turn: @turn,
      current_match_player: @current_match_player %>
