<% content_for :mobile_header_action do %>
  <%= link_to "← Back", matches_path, class: "btn btn-sm theme-btn-outline rounded-pill mono px-3" %>
<% end %>

<%= turbo_stream_from "match_#{@match.id}" %>

<script>
  (function() {
    const matches = JSON.parse(localStorage.getItem("dartz_matches") || "[]")
    const id = <%= @match.id.to_json %>
    const exists = matches.find(m => m.id === id)
    if (!exists) {
      matches.unshift({
        id: id,
        player1: <%= @match.players.first&.display_name.to_json.html_safe %>,
        player2: <%= @match.players.second&.display_name.to_json.html_safe %>,
        createdAt: <%= @match.created_at.iso8601.to_json.html_safe %>
      })
      localStorage.setItem("dartz_matches", JSON.stringify(matches.slice(0, 10)))
    }
  })()
</script>

<div id="finish-popup">
  <% if @match.finished? %>
    <% finishing_leg = @match.match_sets.flat_map(&:legs).max_by(&:created_at) %>
    <% finishing_player = finishing_leg&.winner %>
    <% if finishing_player && finishing_leg.checkout_throws.blank? %>
      <%= render "matches/finish_popup", player: finishing_player, leg: finishing_leg %>
    <% end %>
  <% end %>
</div>

<div class="row justify-content-center" data-controller="match-view">
  <div class="col-12 col-xl-10">
    <div id="game-over-section">
      <% if @match.finished? %>
        <%= render "matches/game_over", match: @match, presenter: @presenter %>
      <% end %>
    </div>

    <div id="header-section">
      <% unless @match.finished? %>
        <div class="theme-card p-3 p-md-4 mb-4 match-header-card">
          <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
            <%= link_to "← Back", matches_path, class: "btn theme-btn-outline rounded-pill mono d-none d-md-inline-flex" %>

            <div class="text-center flex-grow-1 match-header-meta">
              <div class="theme-section-label mono mb-1">Live match</div>
              <h1 class="bebas mb-2" style="font-size:clamp(2rem,6vw,3rem);letter-spacing:0.05em;"><%= @match.ui_identifier %></h1>
              <div class="d-flex flex-wrap align-items-center justify-content-center gap-2">
                <% if @match.best_of_sets > 1 %>
                  <span class="theme-chip mono">Bo<%= @match.best_of_sets %> sets</span>
                <% end %>
                <span class="theme-chip mono">Bo<%= @match.best_of_legs %> legs</span>
              </div>
            </div>

            <div class="text-md-end match-header-meta">
              <div class="mono text-subtle-theme small">Created</div>
              <div class="mono small"><%= @match.created_at.strftime("%d %b · %H:%M") %></div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% unless @match.finished? %>
      <div class="mobile-view-switch mb-3">
        <div class="theme-card p-2">
          <div class="d-grid gap-2" style="grid-template-columns:repeat(2,minmax(0,1fr));">
            <button type="button"
                    class="btn mono"
                    data-match-view-target="padButton"
                    data-action="match-view#showPad">
              Throw pad
            </button>
            <button type="button"
                    class="btn mono"
                    data-match-view-target="inputButton"
                    data-action="match-view#showInput">
              Input
            </button>
          </div>
        </div>
      </div>
    <% end %>

    <div id="score-cards-section">
      <% unless @match.finished? %>
        <div class="row g-3 g-md-4 mb-4">
          <% @presenter.players.each do |player| %>
            <div class="col-12 col-md-6">
              <%= render "matches/score_card", match: @match, presenter: @presenter, player: player %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div id="keyboard-section">
      <% unless @match.finished? %>
        <div class="row g-4">
          <div class="col-12 col-lg-5 order-2 order-lg-1" data-match-view-target="input">
            <div class="theme-panel p-3 p-md-4 h-100">
              <div id="current-player">
                <%= render "matches/current_player", match: @match, presenter: @presenter, turn: @turn %>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-7 order-1 order-lg-2" data-match-view-target="pad">
            <div id="dart-board">
              <%= render "matches/dart_board", match: @match, turn: @turn %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
