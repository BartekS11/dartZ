<% presenter ||= MatchStatePresenter.new(match) %>
<% viewer_player = local_assigns[:current_match_player] || current_match_player(match) %>
<div id="match-live" class="page-shell match-focus <%= 'match-scoring' unless match.finished? %>"
     data-controller="match-view"
     data-match-view-remote-invite-value="<%= match.invite_match? %>"
     data-match-view-my-player-id-value="<%= viewer_player&.id %>"
     data-match-view-my-player-public-id-value="<%= viewer_player&.public_id %>"
     data-match-view-match-public-id-value="<%= match.public_id %>"
     data-match-view-player-names-value="<%= presenter.players.map(&:display_name).to_json %>"
     data-match-view-guest-token-value="<%= Current.user ? nil : match.guest_token %>"
     data-match-view-created-at-value="<%= match.created_at.iso8601 %>">

  <% if VoiceAnnouncement.authorized_user?(Current.user) %>
    <div id="voice-announcements" hidden></div>
  <% end %>

  <div id="game-over-section">
    <% if match.finished? %>
      <%= render "matches/game_over", match: match, presenter: presenter %>
    <% end %>
  </div>

  <% unless match.finished? %>
    <%= render "matches/score_cards", match: match, presenter: presenter %>

    <div id="keyboard-section" class="match-play-area">

      <div data-match-view-target="input">
        <div id="current-player">
          <%= render "matches/current_player",
           match: match,
           presenter: presenter,
           turn: presenter.current_turn,
           current_match_player: viewer_player %>
        </div>
      </div>

      <div data-match-view-target="pad">
        <%= render "matches/dart_board",
              match: match,
              turn: turn %>
      </div>

    </div>
  <% end %>

</div>
