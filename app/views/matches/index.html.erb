<div class="mx-auto max-w-7xl"
     data-controller="lobby"
     data-lobby-signed-in-value="<%= Current.user.present? %>"
     data-lobby-current-user-name-value="<%= Current.user&.display_name.to_s %>">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1.02fr)_minmax(0,1.18fr)] lg:gap-8">
    <section class="space-y-6">
      <div class="space-y-3">
        <div class="theme-section-label mono">DartZ lobby</div>
        <h1 class="theme-section-title bebas">A calmer, cleaner way to track every match.</h1>
        <p class="theme-subtitle max-w-xl">Start fast, keep recent games within reach, and stay comfortable on mobile without losing the sharp edge of the original palette.</p>
      </div>

      <div id="greeting-wrapper" class="theme-card hidden p-4 md:p-5">
        <p class="mono mb-1 text-xs uppercase tracking-[0.18em] text-zinc-500">Last players</p>
        <p data-lobby-target="greeting" class="bebas mb-0 text-3xl leading-none"></p>
      </div>

      <div class="theme-card p-4 md:p-6">
        <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div>
            <p class="theme-section-label mono mb-1">New match</p>
            <h2 class="bebas mb-2 text-3xl leading-none">501 setup</h2>
            <p class="theme-subtitle mb-0 text-sm">Simple inputs, quick presets, and a layout that stays tidy on smaller screens.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" data-action="click->lobby#clearMatches" class="btn btn-sm theme-btn-outline rounded-pill mono">Clear matches</button>
            <button type="button" data-action="click->lobby#clearPlayers" class="btn btn-sm theme-btn-outline rounded-pill mono">Clear players</button>
          </div>
        </div>

        <%= form_with url: matches_path, method: :post, data: { turbo: false, action: "submit->lobby#savePlayers" } do |f| %>
          <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] md:items-center">
            <div class="theme-panel player-card-shell h-full p-4">
              <div class="mb-3 flex items-center justify-between gap-3">
                <label class="mono text-xs uppercase tracking-[0.18em] text-zinc-500">Player 1</label>
                <button type="button" data-action="click->lobby#toggleDropdown1" class="saved-btn mono">Saved</button>
              </div>
              <%= f.text_field :player1_name,
                    placeholder: "Enter name",
                    maxlength: 20,
                    autocomplete: "off",
                    data: { lobby_target: "player1", action: "input->lobby#save" },
                    class: "form-control theme-form-input mono text-center" %>
              <div data-lobby-target="dropdown1" class="saved-dropdown"></div>
            </div>

            <div class="flex justify-center">
              <div class="flex items-center gap-3 md:flex-col">
                <span class="bebas text-2xl text-red-500/80">VS</span>
                <button type="button" data-action="click->lobby#swapPlayers" class="btn swap-badge inline-flex items-center justify-center">⇅</button>
              </div>
            </div>

            <div class="theme-panel player-card-shell h-full p-4">
              <div class="mb-3 flex items-center justify-between gap-3">
                <label class="mono text-xs uppercase tracking-[0.18em] text-zinc-500">Player 2</label>
                <button type="button" data-action="click->lobby#toggleDropdown2" class="saved-btn mono">Saved</button>
              </div>
              <%= f.text_field :player2_name,
                    placeholder: "Enter name",
                    maxlength: 20,
                    autocomplete: "off",
                    data: { lobby_target: "player2", action: "input->lobby#save" },
                    class: "form-control theme-form-input mono text-center" %>
              <div data-lobby-target="dropdown2" class="saved-dropdown"></div>
            </div>
          </div>

          <div class="mt-4 grid gap-4 lg:grid-cols-2">
            <div class="theme-panel p-4">
              <label class="mono mb-3 block text-xs uppercase tracking-[0.18em] text-zinc-500">Best of legs</label>
              <div class="mb-3 flex flex-wrap gap-2">
                <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                  <button type="button"
                          class="btn btn-sm theme-btn-outline rounded-pill mono legs-preset <%= 'border-danger text-danger' if val == 1 %>"
                          onclick="document.getElementById('best_of_legs').value = <%= val %>; this.closest('.theme-panel').querySelectorAll('.legs-preset').forEach(b => b.classList.remove('border-danger','text-danger')); this.classList.add('border-danger','text-danger')">
                    <%= label %>
                  </button>
                <% end %>
              </div>
              <%= number_field_tag :best_of_legs, 1, min: 1, max: 99, id: "best_of_legs", class: "form-control theme-form-input mono" %>
            </div>

            <div class="theme-panel p-4">
              <label class="mono mb-3 block text-xs uppercase tracking-[0.18em] text-zinc-500">Best of sets</label>
              <div class="mb-3 flex flex-wrap gap-2">
                <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                  <button type="button"
                          class="btn btn-sm theme-btn-outline rounded-pill mono sets-preset <%= 'border-danger text-danger' if val == 1 %>"
                          onclick="document.getElementById('best_of_sets').value = <%= val %>; this.closest('.theme-panel').querySelectorAll('.sets-preset').forEach(b => b.classList.remove('border-danger','text-danger')); this.classList.add('border-danger','text-danger')">
                    <%= label %>
                  </button>
                <% end %>
              </div>
              <%= number_field_tag :best_of_sets, 1, min: 1, max: 99, id: "best_of_sets", class: "form-control theme-form-input mono" %>
            </div>
          </div>

          <%= f.submit "Start Match",
                class: "btn theme-btn-primary mt-5 w-full rounded-pill py-3 text-center bebas text-xl" %>
        <% end %>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="theme-section-label mono mb-1">Recent matches</p>
          <h2 class="bebas mb-0 text-3xl leading-none">Continue or review</h2>
        </div>
      </div>

      <% if Current.user && @matches.any? %>
        <div class="grid gap-3">
          <% @matches.each_with_index do |match, i| %>
            <% presenter = MatchStatePresenter.new(match) %>
            <% winner = presenter.winner %>
            <%= link_to match_path(match), class: "theme-match-card p-4 md:p-5" do %>
              <div class="grid gap-4 md:grid-cols-[auto_minmax(0,0.8fr)_minmax(0,1fr)_auto] md:items-start">
                <div class="match-meta-index mono text-sm"><%= i + 1 %></div>

                <div>
                  <div class="match-identifier bebas"><%= match.ui_identifier %></div>
                  <div class="mono mb-3 mt-1 text-xs text-zinc-500"><%= match.created_at.strftime("%d %b · %H:%M") %></div>
                  <div class="flex flex-wrap gap-2">
                    <% if match.best_of_sets > 1 %>
                      <span class="theme-chip mono">Bo<%= match.best_of_sets %> sets</span>
                    <% end %>
                    <span class="theme-chip mono">Bo<%= match.best_of_legs %> legs</span>
                  </div>
                </div>

                <div>
                  <% presenter.players.each do |player| %>
                    <% is_winner = winner == player %>
                    <% score = presenter.score_for(player) %>
                    <% avg = presenter.three_dart_average(player) %>
                    <% pct = [(501 - score) * 100 / 501, 0].max %>
                    <div class="player-line">
                      <span class="name mono <%= 'is-winner' if is_winner %>"><%= player.display_name %></span>
                      <span class="value bebas <%= 'is-winner' if is_winner %>"><%= score %></span>
                      <% if avg > 0 %>
                        <span class="avg mono">avg <%= avg %></span>
                      <% end %>
                    </div>
                    <div class="progress-thin mb-2"><span style="width:<%= pct %>%; background:<%= is_winner ? 'var(--theme-success)' : 'var(--theme-border-strong)' %>"></span></div>
                  <% end %>
                </div>

                <div class="flex flex-col items-start gap-3 md:items-end">
                  <span class="theme-chip mono <%= match.finished? ? 'is-finished' : 'is-live' %>"><%= match.finished? ? 'Finished' : 'Live' %></span>
                  <span class="mono text-xs uppercase tracking-[0.18em] text-red-400">Open match →</span>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="theme-card p-4 md:p-5">
          <div class="mb-4 flex items-start justify-between gap-4">
            <div>
              <p class="theme-section-label mono mb-1">No server history yet</p>
              <h3 class="bebas mb-1 text-2xl leading-none">Recent local sessions</h3>
              <p class="theme-subtitle mb-0 text-sm">Guest matches you start on this device will show here.</p>
            </div>
          </div>
          <div data-lobby-target="matchList" class="grid gap-3"></div>
        </div>
      <% end %>
    </section>
  </div>
</div>
