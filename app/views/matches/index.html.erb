<div class="row justify-content-center g-4"
     data-controller="lobby"
     data-lobby-signed-in-value="<%= Current.user.present? %>"
     data-lobby-current-user-name-value="<%= Current.user&.display_name.to_s %>">
  <div class="col-12 col-xl-10">
    <div class="row g-4 align-items-start">
      <div class="col-12 col-lg-5">
        <div class="mb-4">
          <div class="theme-section-label mono mb-2">DartZ lobby</div>
          <h1 class="theme-section-title bebas mb-2">Your Matches</h1>
          <p class="theme-subtitle mb-0">Start a leg fast, continue live matches, and keep recent sessions within reach.</p>
        </div>

        <div id="greeting-wrapper" class="theme-card p-3 p-md-4 mb-4 hidden">
          <p class="mono text-subtle-theme small text-uppercase mb-1">Last players</p>
          <p data-lobby-target="greeting" class="bebas fs-2 mb-0"></p>
        </div>

        <div class="theme-card p-3 p-md-4">
          <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
            <div>
              <p class="theme-section-label mono mb-1">New match</p>
              <h2 class="bebas mb-0 fs-2">501 setup</h2>
            </div>
            <div class="d-flex gap-2">
              <button type="button" data-action="click->lobby#clearMatches" class="btn btn-sm theme-btn-outline rounded-pill mono">Clear matches</button>
              <button type="button" data-action="click->lobby#clearPlayers" class="btn btn-sm theme-btn-outline rounded-pill mono">Clear players</button>
            </div>
          </div>

          <%= form_with url: matches_path, method: :post, data: { turbo: false, action: "submit->lobby#savePlayers" } do |f| %>
            <div class="row g-3 align-items-center mb-3">
              <div class="col-12 col-sm-5">
                <div class="theme-panel p-3 player-card-shell h-100 position-relative">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <label class="mono text-subtle-theme small text-uppercase">Player 1</label>
                    <button type="button" data-action="click->lobby#toggleDropdown1" class="saved-btn mono">Saved</button>
                  </div>
                  <%= f.text_field :player1_name,
                        placeholder: "Enter name",
                        maxlength: 20,
                        autocomplete: "off",
                        data: { lobby_target: "player1", action: "input->lobby#save" },
                        class: "form-control theme-form-input text-center mono" %>
                  <div data-lobby-target="dropdown1" class="saved-dropdown"></div>
                </div>
              </div>

              <div class="col-12 col-sm-2 text-center">
                <div class="d-flex flex-sm-column align-items-center justify-content-center gap-2 h-100">
                  <span class="bebas fs-3 text-primary-theme opacity-75">VS</span>
                  <button type="button" data-action="click->lobby#swapPlayers" class="btn swap-badge d-inline-flex align-items-center justify-content-center">⇅</button>
                </div>
              </div>

              <div class="col-12 col-sm-5">
                <div class="theme-panel p-3 player-card-shell h-100 position-relative">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <label class="mono text-subtle-theme small text-uppercase">Player 2</label>
                    <button type="button" data-action="click->lobby#toggleDropdown2" class="saved-btn mono">Saved</button>
                  </div>
                  <%= f.text_field :player2_name,
                        placeholder: "Enter name",
                        maxlength: 20,
                        autocomplete: "off",
                        data: { lobby_target: "player2", action: "input->lobby#save" },
                        class: "form-control theme-form-input text-center mono" %>
                  <div data-lobby-target="dropdown2" class="saved-dropdown"></div>
                </div>
              </div>
            </div>

            <div class="theme-panel p-3 mb-4">
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <label class="mono text-subtle-theme small text-uppercase mb-2 d-block">Best of legs</label>
                  <div class="d-flex flex-wrap gap-2 mb-2">
                    <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                      <button type="button"
                              class="btn btn-sm theme-btn-outline rounded-pill mono legs-preset <%= 'border-danger text-danger' if val == 1 %>"
                              onclick="document.getElementById('best_of_legs').value = <%= val %>; this.closest('.col-md-6').querySelectorAll('.legs-preset').forEach(b => b.classList.remove('border-danger','text-danger')); this.classList.add('border-danger','text-danger')">
                        <%= label %>
                      </button>
                    <% end %>
                  </div>
                  <%= number_field_tag :best_of_legs, 1, min: 1, max: 99, id: "best_of_legs", class: "form-control theme-form-input mono" %>
                </div>

                <div class="col-12 col-md-6">
                  <label class="mono text-subtle-theme small text-uppercase mb-2 d-block">Best of sets</label>
                  <div class="d-flex flex-wrap gap-2 mb-2">
                    <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                      <button type="button"
                              class="btn btn-sm theme-btn-outline rounded-pill mono sets-preset <%= 'border-danger text-danger' if val == 1 %>"
                              onclick="document.getElementById('best_of_sets').value = <%= val %>; this.closest('.col-md-6').querySelectorAll('.sets-preset').forEach(b => b.classList.remove('border-danger','text-danger')); this.classList.add('border-danger','text-danger')">
                        <%= label %>
                      </button>
                    <% end %>
                  </div>
                  <%= number_field_tag :best_of_sets, 1, min: 1, max: 99, id: "best_of_sets", class: "form-control theme-form-input mono" %>
                </div>
              </div>
            </div>

            <%= f.submit "Start Match",
                  class: "btn theme-btn-primary w-100 rounded-pill bebas fs-4 py-3" %>
          <% end %>
        </div>
      </div>

      <div class="col-12 col-lg-7">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div>
            <p class="theme-section-label mono mb-1">Recent matches</p>
            <h2 class="bebas fs-2 mb-0">Continue or review</h2>
          </div>
        </div>

        <% if Current.user && @matches.any? %>
          <div class="d-grid gap-3">
            <% @matches.each_with_index do |match, i| %>
              <% presenter = MatchStatePresenter.new(match) %>
              <% winner = presenter.winner %>
              <%= link_to match_path(match), class: "theme-match-card p-3 p-md-4" do %>
                <div class="row align-items-start g-3 position-relative">
                  <div class="col-auto">
                    <div class="match-meta-index mono small"><%= i + 1 %></div>
                  </div>
                  <div class="col-12 col-sm-4">
                    <div class="match-identifier bebas"><%= match.ui_identifier %></div>
                    <div class="mono text-subtle-theme small mb-2"><%= match.created_at.strftime("%d %b · %H:%M") %></div>
                    <div class="d-flex flex-wrap gap-2">
                      <% if match.best_of_sets > 1 %>
                        <span class="theme-chip mono">Bo<%= match.best_of_sets %> sets</span>
                      <% end %>
                      <span class="theme-chip mono">Bo<%= match.best_of_legs %> legs</span>
                    </div>
                  </div>

                  <div class="col-12 col-sm-5">
                    <% presenter.players.each do |player| %>
                      <% is_winner = winner == player %>
                      <% score = presenter.score_for(player) %>
                      <% avg = presenter.three_dart_average(player) %>
                      <% pct = [(501 - score) * 100 / 501, 0].max %>
                      <div class="player-line">
                        <span class="name mono <%= 'is-winner' if is_winner %>"><%= player.display_name %></span>
                        <span class="value bebas <%= 'is-winner' if is_winner %>"><%= score %></span>
                        <% if avg > 0 %>
                          <span class="avg mono">avg <%= avg %></span>
                        <% end %>
                      </div>
                      <div class="progress-thin"><span style="width:<%= pct %>%; background:<%= is_winner ? 'var(--theme-success)' : 'var(--theme-border-strong)' %>"></span></div>
                    <% end %>
                  </div>

                  <div class="col-12 col-sm-3 text-sm-end">
                    <span class="theme-chip mono <%= match.finished? ? 'is-finished' : 'is-live' %>"><%= match.finished? ? 'Finished' : 'Live' %></span>
                    <div class="mt-3 mono text-primary-theme small">Open →</div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div data-lobby-target="matchList" class="d-grid gap-3"></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
