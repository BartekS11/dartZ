<div class="page-shell stack-lg"
     data-controller="lobby"
     data-lobby-signed-in-value="<%= Current.user.present? %>"
     data-lobby-current-user-name-value="<%= Current.user&.display_name.to_s %>">
  <section class="theme-hero simple-setup p-5">
    <div class="setup-heading mb-4">
      <div class="theme-section-label"></div>
      <h1 class="page-title">New game</h1>
    </div>

    <%= form_with url: matches_path, method: :post, data: { turbo: false, action: "submit->lobby#savePlayers" }, class: "stack-md" do |f| %>
      <div class="simple-step">
        <div class="simple-step-number">1</div>
        <div>
          <div class="theme-section-label">Players</div>
        </div>
      </div>

      <div class="columns is-variable is-3 is-vcentered">
        <div class="column">
          <div class="player-card-shell">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
              <label class="auth-label">Player 1</label>
              <button type="button" data-lobby-target="savedButton1" data-action="click->lobby#toggleDropdown1" class="saved-btn mono">Saved names</button>
            </div>
            <%= f.text_field :player1_name,
                  placeholder: "Enter name",
                  maxlength: 20,
                  autocomplete: "off",
                  data: { lobby_target: "player1", action: "input->lobby#save" },
                  class: "input theme-form-input mono has-text-centered" %>
            <div data-lobby-target="dropdown1" class="saved-dropdown"></div>
          </div>
        </div>

        <div class="column is-narrow has-text-centered">
          <button type="button" data-action="click->lobby#swapPlayers" class="button theme-btn-outline swap-badge">⇄</button>
        </div>

        <div class="column">
          <div class="player-card-shell">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
              <label class="auth-label">Player 2</label>
              <button type="button" data-lobby-target="savedButton2" data-action="click->lobby#toggleDropdown2" class="saved-btn mono">Saved names</button>
            </div>
            <%= f.text_field :player2_name,
                  placeholder: "Enter name",
                  maxlength: 20,
                  autocomplete: "off",
                  data: { lobby_target: "player2", action: "input->lobby#save" },
                  class: "input theme-form-input mono has-text-centered" %>
            <div data-lobby-target="dropdown2" class="saved-dropdown"></div>
          </div>
        </div>
      </div>

      <div class="simple-step">
        <div class="simple-step-number">2</div>
        <div>
          <div class="theme-section-label">Rules</div>
        </div>
      </div>

      <div class="columns is-variable is-3">
        <div class="column">
          <div class="theme-panel p-4">
            <label class="auth-label">Starting score</label>
            <div class="buttons are-small mt-2">
              <% Match::X01_STARTING_SCORES.each do |score| %>
                <button type="button"
                        class="button theme-btn-outline mono score-preset <%= 'is-selected' if score == 501 %>"
                        onclick="document.getElementById('starting_score').value = <%= score %>; this.closest('.buttons').querySelectorAll('.score-preset').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')">
                  <%= score %>
                </button>
              <% end %>
            </div>
            <%= hidden_field_tag :starting_score, 501, id: "starting_score" %>
          </div>
        </div>

        <div class="column">
          <div class="theme-panel p-4">
            <label class="auth-label">Best of legs</label>
            <div class="buttons are-small mt-2">
              <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                <button type="button"
                        class="button theme-btn-outline mono legs-preset <%= 'is-selected' if val == 1 %>"
                        onclick="document.getElementById('best_of_legs').value = <%= val %>; this.closest('.buttons').querySelectorAll('.legs-preset').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')">
                  <%= label %>
                </button>
              <% end %>
            </div>
            <%= number_field_tag :best_of_legs, 1, min: 1, max: 99, id: "best_of_legs", class: "input theme-form-input mono" %>
          </div>
        </div>

        <div class="column">
          <div class="theme-panel p-4">
            <label class="auth-label">Best of sets</label>
            <div class="buttons are-small mt-2">
              <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                <button type="button"
                        class="button theme-btn-outline mono sets-preset <%= 'is-selected' if val == 1 %>"
                        onclick="document.getElementById('best_of_sets').value = <%= val %>; this.closest('.buttons').querySelectorAll('.sets-preset').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')">
                  <%= label %>
                </button>
              <% end %>
            </div>
            <%= number_field_tag :best_of_sets, 1, min: 1, max: 99, id: "best_of_sets", class: "input theme-form-input mono" %>
          </div>
        </div>
      </div>

      <div class="columns is-variable is-3">
        <div class="column"><label class="panel-choice"><%= hidden_field_tag :double_in, "0" %><%= check_box_tag :double_in, "1", false %> Double in</label></div>
        <div class="column"><label class="panel-choice"><%= hidden_field_tag :double_out, "0" %><%= check_box_tag :double_out, "1", true %> Double out</label></div>
      </div>

      <div class="simple-step">
        <div class="simple-step-number">3</div>
        <div>
          <div class="theme-section-label">Play</div>
        </div>
      </div>

      <div class="setup-submit-row pt-3">
        <div class="help-theme">
          <div id="greeting-wrapper" class="is-hidden">
            <span class="auth-label">Last players</span>
            <div data-lobby-target="greeting" class="mt-1"></div>
          </div>
        </div>
        <div class="buttons setup-primary-actions">
          <% if Current.user.present? %>
            <%= button_tag "Create invite match",
                  type: "submit",
                  name: "invite_match",
                  value: "1",
                  class: "button theme-btn-outline is-medium" %>
          <% end %>
          <%= f.submit "Start game", class: "button theme-btn-primary is-medium" %>
        </div>
      </div>

      <details class="setup-utility-actions">
        <summary class="mono">Reset options</summary>
        <div class="buttons are-small mt-3">
          <button type="button" data-action="click->lobby#clearPlayers" class="button theme-btn-outline mono">Clear names</button>
          <button type="button" data-action="click->lobby#clearMatches" class="button theme-btn-outline mono">Clear history</button>
        </div>
      </details>
    <% end %>
  </section>

  <section class="stack-md">
    <div class="level">
      <div class="level-left">
        <div>
          <div class="theme-section-label">Recent matches</div>
          <h2 class="section-title">Keep playing</h2>
        </div>
      </div>
      <div class="level-right buttons are-small">
        <%= link_to "Play vs bot", new_bot_match_path, class: "button theme-btn-outline mono" %>
        <%= link_to "Tournaments", tournaments_path, class: "button theme-btn-outline mono" %>
      </div>
    </div>

    <% if Current.user && @matches.any? %>
      <div class="columns is-multiline">
        <% @matches.each_with_index do |match, i| %>
          <% presenter = MatchStatePresenter.new(match) %>
          <% winner = presenter.winner %>
          <div class="column is-12-tablet is-6-desktop">
            <%= link_to match_path(match), class: "theme-match-card p-4" do %>
              <div class="is-flex is-justify-content-space-between is-align-items-flex-start mb-3">
                <div class="min-w-0">
                  <div class="auth-label">#<%= i + 1 %> · <%= match.created_at.strftime("%d %b · %H:%M") %></div>
                  <div class="match-identifier"><%= match.ui_identifier %></div>
                </div>
                <span class="theme-chip <%= match.finished? ? 'is-finished' : 'is-live' %>"><%= match.finished? ? 'Finished' : 'Live' %></span>
              </div>

              <div class="is-flex is-flex-wrap-wrap" style="gap:.45rem">
                <% match.game_mode_labels.each do |label| %><span class="theme-chip"><%= label %></span><% end %>
                <% if match.best_of_sets > 1 %><span class="theme-chip">Bo<%= match.best_of_sets %> sets</span><% end %>
                <span class="theme-chip">Bo<%= match.best_of_legs %> legs</span>
              </div>

              <div class="stack-sm mt-4">
                <% presenter.players.each do |player| %>
                  <% is_winner = winner == player %>
                  <% score = presenter.score_for(player) %>
                  <% avg = presenter.three_dart_average(player) %>
                  <% pct = [((match.starting_score - score) * 100 / match.starting_score), 0].max %>
                  <div>
                    <div class="player-line mb-2">
                      <span class="name <%= 'is-winner' if is_winner %>"><%= player.display_name %></span>
                      <span class="value <%= 'is-winner' if is_winner %>"><%= score %></span>
                      <% if avg > 0 %><span class="avg">avg <%= avg %></span><% end %>
                    </div>
                    <div class="progress-thin"><span style="width:<%= pct %>%; background:<%= is_winner ? 'var(--theme-success)' : 'var(--theme-border-strong)' %>"></span></div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="theme-blank-slate">
        <div class="auth-label mb-1">Local sessions</div>
        <div data-lobby-target="matchList" class="stack-sm"></div>
      </div>
    <% end %>
  </section>
</div>
