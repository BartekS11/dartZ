<div id="dart-board" class="match-dart-pad">
  <div class="match-pad-head">
    <div class="theme-section-label">Throw pad</div>
    <span class="help-theme">Tap exact darts only when needed.</span>
  </div>

  <div class="dart-grid mb-4">
    <% (1..20).each do |n| %>
      <div class="dart-column">
        <% [:single, :double, :triple].each do |m| %>
          <%= button_to "#{m.to_s[0].upcase}#{n}",
                turn_throws_path(turn),
                params: { throw: { segment: n, multiplier: m } },
                method: :post,
                form: { data: { turbo_stream: true } },
                class: "dart-btn #{m} mono" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="dart-footer-actions">
    <%= button_to "Bull", turn_throws_path(turn), params: { throw: { segment: 25, multiplier: :single } }, method: :post, form: { data: { turbo_stream: true } }, class: "dart-btn single mono" %>
    <%= button_to "Bull ×2", turn_throws_path(turn), params: { throw: { segment: 25, multiplier: :double } }, method: :post, form: { data: { turbo_stream: true } }, class: "dart-btn double mono" %>
    <%= button_to "Miss", turn_throws_path(turn), params: { throw: { segment: 0, multiplier: :miss } }, method: :post, form: { data: { turbo_stream: true } }, class: "dart-btn miss mono" %>
  </div>
</div>
