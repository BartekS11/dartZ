<div id="dart-board" class="theme-panel p-3 p-md-4">
  <div class="theme-panel-header pb-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
      <div class="theme-section-label mono">Throw pad</div>
      <div class="theme-subtitle mt-1">Tap a segment. Built to stay usable on mobile screens.</div>
    </div>
    <span class="theme-chip mono">Finish on a double</span>
  </div>

  <div class="dart-grid mb-3">
    <% (1..20).each do |n| %>
      <div class="dart-column">
        <% [:single, :double, :triple].each do |m| %>
          <%= button_to "#{m.to_s[0].upcase}#{n}",
                turn_throws_path(turn),
                params: { throw: { segment: n, multiplier: m } },
                method: :post,
                form: { data: { turbo_stream: true } },
                class: "dart-btn #{m} mono" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <div class="dart-footer-actions">
    <%= button_to "Bull",
          turn_throws_path(turn),
          params: { throw: { segment: 25, multiplier: :single } },
          method: :post,
          form: { data: { turbo_stream: true } },
          class: "dart-btn single mono" %>
    <%= button_to "Bull ×2",
          turn_throws_path(turn),
          params: { throw: { segment: 25, multiplier: :double } },
          method: :post,
          form: { data: { turbo_stream: true } },
          class: "dart-btn double mono" %>
    <%= button_to "Miss",
          turn_throws_path(turn),
          params: { throw: { segment: 0, multiplier: :miss } },
          method: :post,
          form: { data: { turbo_stream: true } },
          class: "dart-btn miss mono" %>
  </div>
</div>
