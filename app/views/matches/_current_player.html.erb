<% presenter ||= MatchStatePresenter.new(match) %>
<% current_player = presenter.current_player %>
<div
  class="match-input-panel"
  data-controller="keyboard"
  data-keyboard-url-value="<%= turn_throws_path(turn) %>"
  data-keyboard-score-value="<%= presenter.score_for(current_player) %>"
  data-keyboard-player-id-value="<%= current_player.id %>">

  <div class="match-input-head">
    <div>
      <div class="theme-section-label">Current turn</div>
      <h2><%= current_player.display_name %></h2>
    </div>
    <button type="button" data-action="click->keyboard#undoLastThrow" class="button is-small btn-undo mono">↩ Undo</button>
  </div>

  <input type="text"
         data-keyboard-target="input"
         data-action="input->keyboard#preview keydown->keyboard#handle"
         placeholder="Enter score"
         class="input throw-input match-score-input mono has-text-centered"
         autocomplete="off">
</div>

<%= form_with url: turn_throws_path(turn),
              method: :post,
              data: { turbo_stream: true, throws_count: turn.throws.size },
              html: { id: "keyboard-form" } do |f| %>
  <%= f.hidden_field :segment,    name: "throw[segment]",    id: "keyboard-segment" %>
  <%= f.hidden_field :multiplier, name: "throw[multiplier]", id: "keyboard-multiplier" %>
  <%= f.hidden_field :total,      name: "throw[total]",      id: "keyboard-total" %>
<% end %>

<details class="match-stats-toggle">
  <summary class="mono">Stats</summary>
  <%= render "matches/stats_panel", match: match, presenter: presenter %>
</details>
