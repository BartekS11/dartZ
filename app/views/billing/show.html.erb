<div class="page-shell stack-md">
  <section class="theme-hero p-5">
    <div class="level is-align-items-flex-start">
      <div class="level-left">
        <div>
          <div class="theme-section-label"><%= t("common.account") %></div>
          <h1 class="page-title"><%= t("billing.title") %></h1>
        </div>
      </div>
      <div class="level-right">
        <span class="theme-chip <%= premium_access? ? 'is-live' : '' %>"><%= t("billing.current", tier: Current.user.account_tier.humanize) %></span>
      </div>
    </div>
  </section>

  <section class="columns is-multiline is-variable is-3">
    <% @tiers.each do |tier| %>
      <% current_tier = Current.user.account_tier == tier[:key] %>
      <div class="column is-12-tablet is-4-desktop">
        <article class="theme-card p-5 h-full stack-md" style="<%= current_tier ? 'border-color:var(--theme-primary); box-shadow:0 0 0 1px var(--theme-primary);' : '' %>">
          <div>
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <h2 class="section-title"><%= tier[:name] %></h2>
              <% if current_tier %><span class="theme-chip is-live"><%= t("common.current") %></span><% end %>
            </div>
            <p class="page-copy mt-2"><%= tier[:description] %></p>
          </div>

          <div>
            <span class="bebas text-5xl"><%= tier[:price] %></span>
            <span class="help-theme">/ <%= tier[:interval] %></span>
          </div>

          <ul class="stack-sm" style="list-style:none; padding:0; margin:0; flex:1">
            <% tier[:features].each do |feature| %><li class="mono text-sm">✓ <%= feature %></li><% end %>
          </ul>

          <% if current_tier %>
            <button type="button" class="button theme-btn-outline is-fullwidth mono" disabled><%= t("billing.current_plan") %></button>
          <% elsif tier[:key] == "free" %>
            <button type="button" class="button theme-btn-outline is-fullwidth mono" disabled><%= t("common.included") %></button>
          <% else %>
            <%= button_to t("billing.upgrade"), checkout_billing_path(tier: tier[:key]), method: :post, class: "button theme-btn-primary is-fullwidth mono" %>
          <% end %>
        </article>
      </div>
    <% end %>
  </section>

  <section class="theme-card p-5 stack-sm">
    <h2 class="section-title"><%= t("billing.manage_title") %></h2>
    <p class="page-copy"><%= t("billing.currency_note", currency: @billing_currency.upcase) %></p>
    <% if Current.user.premium_access_expires_at.present? %>
      <p class="mono text-sm"><%= t("billing.access_until", date: l(Current.user.premium_access_expires_at.to_date)) %></p>
    <% end %>
    <% if Current.user.stripe_customer_id.present? %>
      <%= button_to t("billing.manage_subscription"), portal_billing_path, method: :post, class: "button theme-btn-outline mono" %>
    <% else %>
      <p class="help-theme"><%= t("billing.no_subscription_help") %></p>
    <% end %>
  </section>
</div>
