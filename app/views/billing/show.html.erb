<div class="page-shell stack-md">
  <section class="theme-hero p-5">
    <div class="level is-align-items-flex-start">
      <div class="level-left">
        <div>
          <div class="theme-section-label"><%= t("common.account") %></div>
          <h1 class="page-title"><%= t("billing.title") %></h1>
        </div>
      </div>
      <div class="level-right">
        <span class="theme-chip <%= premium_access? ? 'is-live' : '' %>"><%= t("billing.current", tier: Current.user.effective_account_tier.humanize) %></span>
      </div>
    </div>
  </section>

  <%= form_with url: billing_path, method: :get, class: "theme-card p-4" do |form| %>
    <div class="columns is-multiline is-variable is-3 is-align-items-flex-end">
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <label class="auth-label" for="billing_interval"><%= t("billing.billing_interval") %></label>
        <%= form.select :billing_interval, [[t("billing.interval_month"), "month"], [t("billing.interval_year_option"), "year"]], { selected: @billing_interval }, { onchange: "this.form.requestSubmit()", class: "select theme-form-input mono", aria: { label: t("billing.billing_interval") } } %>
      </div>
      <div class="column is-12-mobile is-6-tablet is-4-desktop">
        <label class="auth-label" for="billing_currency">Country / currency</label>
        <%= form.select :currency, [["🇺🇸 United States · USD ($)", "usd"], ["🇬🇧 United Kingdom · GBP (£)", "gbp"], ["🇵🇱 Poland · PLN (zł)", "pln"]], { selected: @billing_currency }, { onchange: "this.form.requestSubmit()", class: "select theme-form-input mono", aria: { label: "Country / currency" } } %>
      </div>
    </div>
  <% end %>

  <section class="columns is-multiline is-variable is-3">
    <% @tiers.each do |tier| %>
      <% current_tier = Current.user.effective_account_tier == tier[:key] %>
      <div class="column is-12-tablet is-4-desktop">
        <article class="theme-card p-5 h-full stack-md" style="<%= current_tier ? 'border-color:var(--theme-primary); box-shadow:0 0 0 1px var(--theme-primary);' : '' %>">
          <div>
            <div class="is-flex is-justify-content-space-between is-align-items-center">
              <h2 class="section-title"><%= tier[:name] %></h2>
              <% if current_tier %><span class="theme-chip is-live"><%= t("common.current") %></span><% end %>
            </div>
            <p class="page-copy mt-2"><%= tier[:description] %></p>
          </div>

          <div>
            <span class="bebas text-5xl"><%= tier[:price] %></span>
            <span class="help-theme">/ <%= tier[:interval] %></span>
          </div>

          <ul class="billing-feature-list">
            <% tier[:features].each do |feature| %><li><%= feature %></li><% end %>
          </ul>

          <% if current_tier && @billing_interval == "month" %>
            <button type="button" class="button theme-btn-outline is-fullwidth mono" disabled><%= t("billing.current_plan") %></button>
          <% elsif tier[:key] == "free" %>
            <button type="button" class="button theme-btn-outline is-fullwidth mono" disabled><%= t("common.included") %></button>
          <% else %>
            <% if Current.user.subscribed? && !current_tier %>
              <div data-controller="confirmation-modal">
                <button type="button" class="button theme-btn-primary is-fullwidth mono" data-action="confirmation-modal#open"><%= t("billing.upgrade") %></button>
                <dialog class="billing-switch-dialog" data-confirmation-modal-target="dialog">
                  <div class="billing-switch-dialog__content">
                    <h2 class="section-title"><%= t("billing.confirm_switch_title") %></h2>
                    <p class="page-copy"><%= t("billing.confirm_switch_message", tier: tier[:name]) %></p>
                    <div class="billing-switch-dialog__actions">
                      <%= button_to t("billing.confirm_switch_button"), checkout_billing_path(tier: tier[:key], interval: @billing_interval, currency: @billing_currency), method: :post, class: "button theme-btn-primary mono", data: { turbo: false } %>
                      <button type="button" class="button theme-btn-outline mono" data-action="confirmation-modal#close"><%= t("common.cancel") %></button>
                    </div>
                  </div>
                </dialog>
              </div>
            <% else %>
              <%= button_to(current_tier ? t("billing.switch_yearly") : t("billing.upgrade"), checkout_billing_path(tier: tier[:key], interval: @billing_interval, currency: @billing_currency), method: :post, class: "button theme-btn-primary is-fullwidth mono", data: { turbo: false }) %>
            <% end %>
          <% end %>
        </article>
      </div>
    <% end %>
  </section>

  <section class="theme-card p-5 stack-sm">
    <h2 class="section-title"><%= t("billing.manage_title") %></h2>
    <p class="page-copy"><%= t("billing.currency_note", currency: @billing_currency.upcase) %></p>
    <% if Current.user.premium_access_expires_at.present? %>
      <p class="subscription-end-date <%= 'is-cancelled' if Current.user.stripe_cancel_at_period_end? %>">
        <%= t("billing.access_until", date: l(Current.user.premium_access_expires_at.to_date)) %>
        <% if Current.user.stripe_cancel_at_period_end? %>
          <span class="subscription-end-date__status"><%= t("billing.cancel_pending") %></span>
        <% end %>
      </p>
    <% end %>
    <% if Current.user.stripe_customer_id.present? %>
      <%= button_to t("billing.manage_subscription"), portal_billing_path, method: :post, class: "button theme-btn-outline mono" %>
    <% end %>
    <% if Current.user.subscribed? && Current.user.stripe_cancel_at_period_end? %>
      <p class="help-theme"><%= t("billing.cancel_pending") %></p>
    <% elsif Current.user.subscribed? %>
      <div data-controller="confirmation-modal">
        <button type="button" class="button theme-btn-outline mono" data-action="confirmation-modal#open"><%= t("billing.cancel_subscription") %></button>
        <dialog class="billing-switch-dialog" data-confirmation-modal-target="dialog">
          <div class="billing-switch-dialog__content">
            <h2 class="section-title"><%= t("billing.cancel_confirm_title") %></h2>
            <p class="page-copy"><%= t("billing.cancel_confirm_message") %></p>
            <div class="billing-switch-dialog__actions">
              <%= button_to t("billing.cancel_confirm_button"), cancel_subscription_billing_path, method: :post, class: "button theme-btn-primary mono", data: { turbo: false } %>
              <button type="button" class="button theme-btn-outline mono" data-action="confirmation-modal#close"><%= t("common.cancel") %></button>
            </div>
          </div>
        </dialog>
      </div>
    <% elsif Current.user.stripe_customer_id.blank? %>
      <p class="help-theme"><%= t("billing.no_subscription_help") %></p>
    <% end %>
  </section>
</div>
