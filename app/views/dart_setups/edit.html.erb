<div class="page-shell stack-md">
  <section class="theme-hero p-5 dart-setup-page">
    <div class="level is-align-items-flex-start mb-4">
      <div class="level-left">
        <div>
          <div class="theme-section-label"><%= t("dart_setup.premium") %></div>
          <h1 class="page-title"><%= t("dart_setup.title") %></h1>
        </div>
      </div>
      <div class="level-right"><span class="theme-chip is-live"><%= Current.user.account_tier.humanize %></span></div>
    </div>

    <div class="current-dart-setup-card mb-5">
      <div>
        <div class="theme-section-label"><%= t("dart_setup.currently_saved") %></div>
        <% if @dart_setup.persisted? %>
          <h2><%= @dart_setup.display_summary %></h2>
          <p class="page-copy mt-1"><%= t("dart_setup.snapshot_copy") %></p>
        <% else %>
          <h2><%= t("dart_setup.default_ready") %></h2>
          <p class="page-copy mt-1"><%= t("dart_setup.save_to_track") %></p>
        <% end %>
      </div>
      <div class="current-dart-setup-metrics mono">
        <span><strong><%= @dart_setup.weight_g.to_s.sub(/\.0$/, '') %>g</strong><%= t("dart_setup.weight") %></span>
        <span><strong><%= @dart_setup.shaft_length_mm %>mm</strong><%= t("dart_setup.shaft") %></span>
        <span><strong><%= @dart_setup.point_length_mm %>mm</strong><%= t("dart_setup.point") %></span>
      </div>
    </div>

    <%= form_with model: @dart_setup, url: dart_setup_path, method: :patch, class: "stack-md" do |f| %>
      <% if @dart_setup.errors.any? %>
        <div class="flash-theme alert mono"><%= pluralize(@dart_setup.errors.count, "error") %> prevented this setup from being saved.</div>
      <% end %>

      <div class="dart-setup-section">
        <div class="theme-section-label"><%= t("dart_setup.manufacturer") %></div>
        <div class="dart-option-grid dart-manufacturer-grid">
          <% DartSetup::MANUFACTURER_LABELS.each do |value, label| %>
            <label class="button theme-btn-outline mono dart-option <%= 'is-selected' if @dart_setup.manufacturer == value %>">
              <%= f.radio_button :manufacturer,
                    value,
                    class: "sr-only",
                    onchange: "this.closest('.dart-option-grid').querySelectorAll('.dart-option').forEach(el => el.classList.remove('is-selected')); this.closest('.dart-option').classList.add('is-selected')" %>
              <span><%= label %></span>
            </label>
          <% end %>
        </div>
      </div>

      <div class="columns is-variable is-4">
        <div class="column">
          <div class="dart-setup-section">
            <div class="theme-section-label"><%= t("dart_setup.weight") %></div>
            <div class="dart-preset-row mb-3">
              <% [21, 22, 23, 24, 25, 26].each do |weight| %>
                <button type="button"
                        class="button theme-btn-outline mono dart-preset-btn <%= 'is-selected' if @dart_setup.weight_g.to_f == weight.to_f %>"
                        onclick="document.getElementById('dart_setup_weight_g').value = <%= weight %>; this.closest('.dart-setup-section').querySelectorAll('.dart-preset-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')">
                  <%= weight %>g
                </button>
              <% end %>
            </div>
            <%= f.number_field :weight_g, min: 10, max: 60, step: 0.1, class: "input theme-form-input mono", id: "dart_setup_weight_g" %>
          </div>
        </div>

        <div class="column">
          <div class="dart-setup-section">
            <div class="theme-section-label"><%= t("dart_setup.shaft_type") %></div>
            <div class="dart-option-grid dart-shaft-grid">
              <% DartSetup::SHAFT_TYPES.each do |type| %>
                <label class="button theme-btn-outline mono dart-option <%= 'is-selected' if @dart_setup.shaft_type == type %>">
                  <%= f.radio_button :shaft_type,
                        type,
                        class: "sr-only",
                        onchange: "this.closest('.dart-option-grid').querySelectorAll('.dart-option').forEach(el => el.classList.remove('is-selected')); this.closest('.dart-option').classList.add('is-selected')" %>
                  <span><%= type.humanize %></span>
                </label>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="columns is-variable is-4">
        <div class="column">
          <div class="dart-setup-section">
            <div class="theme-section-label"><%= t("dart_setup.shaft_length") %></div>
            <div class="dart-preset-row mb-3">
              <% [34, 36, 40, 42, 45, 48].each do |length| %>
                <button type="button"
                        class="button theme-btn-outline mono dart-preset-btn <%= 'is-selected' if @dart_setup.shaft_length_mm.to_i == length %>"
                        onclick="document.getElementById('dart_setup_shaft_length_mm').value = <%= length %>; this.closest('.dart-setup-section').querySelectorAll('.dart-preset-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')">
                  <%= length %>mm
                </button>
              <% end %>
            </div>
            <%= f.number_field :shaft_length_mm, min: 20, max: 70, step: 1, class: "input theme-form-input mono", id: "dart_setup_shaft_length_mm" %>
          </div>
        </div>

        <div class="column">
          <div class="dart-setup-section">
            <div class="theme-section-label"><%= t("dart_setup.point_length") %></div>
            <div class="dart-preset-row mb-3">
              <% [26, 30, 32, 35, 38, 40].each do |length| %>
                <button type="button"
                        class="button theme-btn-outline mono dart-preset-btn <%= 'is-selected' if @dart_setup.point_length_mm.to_i == length %>"
                        onclick="document.getElementById('dart_setup_point_length_mm').value = <%= length %>; this.closest('.dart-setup-section').querySelectorAll('.dart-preset-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')">
                  <%= length %>mm
                </button>
              <% end %>
            </div>
            <%= f.number_field :point_length_mm, min: 20, max: 60, step: 1, class: "input theme-form-input mono", id: "dart_setup_point_length_mm" %>
          </div>
        </div>
      </div>

      <div class="level pt-4" style="border-top:1px solid var(--theme-line)">
        <div class="level-left"><p class="page-copy"><%= t("dart_setup.no_rewrite") %></p></div>
        <div class="level-right"><%= f.submit "Save setup", class: "button theme-btn-primary is-medium" %></div>
      </div>
    <% end %>
  </section>

  <section class="theme-card p-5">
    <div class="mb-4">
      <%# <div class="theme-section-label">Premium stats</div> %>
      <%# <h2 class="section-title">Stats by dart setup</h2> %>
    </div>

    <% if @setup_stats.any? %>
      <div class="columns is-multiline is-variable is-3">
        <% @setup_stats.each do |stats| %>
          <div class="column is-6-desktop">
            <article class="theme-match-card p-4 dart-setup-stats-card">
              <div class="dart-setup-stats-head">
                <div>
                  <div class="auth-label"><%= t("dart_setup.saved_setup") %></div>
                  <h3><%= stats[:setup] %></h3>
                </div>
                <div class="dart-setup-stats-actions">
                  <% if @dart_setup.fingerprint == stats[:fingerprint] %>
                    <span class="theme-chip is-live"><%= t("common.current") %></span>
                  <% else %>
                    <%= button_to "Use setup",
                          use_saved_dart_setup_path,
                          method: :patch,
                          params: { fingerprint: stats[:fingerprint] },
                          class: "button theme-btn-outline is-small mono" %>
                  <% end %>
                </div>
              </div>

              <div class="compact-stats-list mono text-sm">
                <div class="compact-stat"><span><%= t("dart_setup.matches") %></span><strong><%= stats[:matches] %></strong></div>
                <div class="compact-stat"><span><%= t("dart_setup.average") %></span><strong><%= stats[:average_per_turn] %></strong></div>
                <div class="compact-stat"><span><%= t("dart_setup.highest_turn") %></span><strong><%= stats[:highest_turn] %></strong></div>
                <div class="compact-stat"><span><%= t("dart_setup.darts_thrown") %></span><strong><%= stats[:darts_thrown] %></strong></div>
                <div class="compact-stat"><span><%= t("dart_setup.double_hits") %></span><strong><%= stats[:double_hits] %> (<%= stats[:double_hit_share] %>%)</strong></div>
                <div class="compact-stat"><span><%= t("live_match.checkout") %></span><strong><%= stats[:checkout_rate] %>%</strong></div>
              </div>
            </article>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="flash-theme notice mono"><%= t("dart_setup.no_stats") %></div>
    <% end %>
  </section>
</div>
