<div class="page-shell w-full px-1">
  <section class="theme-hero counter-setup-card overflow-hidden p-4 md:p-5">
    <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <div class="page-header">
        <div class="theme-section-label mono">Premium</div>
        <h1 class="page-title bebas">Dart setup</h1>
        <p class="counter-section-copy">Save the equipment you use most often.</p>
      </div>
      <span class="theme-chip mono is-live"><%= Current.user.account_tier.humanize %></span>
    </div>

    <%= form_with model: @dart_setup, url: dart_setup_path, method: :patch, class: "grid gap-4" do |f| %>
      <% if @dart_setup.errors.any? %>
        <div class="flash-theme alert mono">
          <%= pluralize(@dart_setup.errors.count, "error") %> prevented this setup from being saved.
        </div>
      <% end %>

      <div class="grid gap-3 md:grid-cols-2">
        <div>
          <%= f.label :manufacturer, "Manufacturer", class: "auth-label mb-2 block" %>
          <%= f.select :manufacturer,
                DartSetup::MANUFACTURER_LABELS.map { |value, label| [label, value] },
                {},
                class: "form-select theme-form-input mono" %>
        </div>

        <div>
          <%= f.label :weight_g, "Weight (g)", class: "auth-label mb-2 block" %>
          <%= f.number_field :weight_g,
                min: 10,
                max: 60,
                step: 0.1,
                class: "form-control theme-form-input mono" %>
        </div>

        <div>
          <%= f.label :shaft_type, "Shaft type", class: "auth-label mb-2 block" %>
          <%= f.select :shaft_type,
                DartSetup::SHAFT_TYPES.map { |type| [type.humanize, type] },
                {},
                class: "form-select theme-form-input mono" %>
        </div>

        <div>
          <%= f.label :shaft_length_mm, "Shaft length (mm)", class: "auth-label mb-2 block" %>
          <%= f.number_field :shaft_length_mm,
                min: 20,
                max: 70,
                step: 1,
                class: "form-control theme-form-input mono" %>
        </div>

        <div>
          <%= f.label :point_length_mm, "Point length (mm)", class: "auth-label mb-2 block" %>
          <%= f.number_field :point_length_mm,
                min: 20,
                max: 60,
                step: 1,
                class: "form-control theme-form-input mono" %>
        </div>
      </div>

      <div class="flex flex-col gap-2 border-t pt-4 sm:flex-row sm:items-center sm:justify-between" style="border-color:var(--theme-line)">
        <p class="m-0 text-sm" style="color:var(--theme-muted)">Stripe can later update the account tier and premium expiry fields.</p>
        <%= f.submit "Save setup", class: "btn theme-btn-primary rounded-pill px-4 py-2.5 bebas text-lg" %>
      </div>
    <% end %>
  </section>

  <section class="theme-hero counter-setup-card mt-4 overflow-hidden p-4 md:p-5">
    <div class="mb-4 page-header">
      <div class="theme-section-label mono">Premium stats</div>
      <h2 class="section-title bebas">Stats by dart setup</h2>
      <p class="counter-section-copy">When you start a match, your current dart setup is snapshotted so future edits do not mix stats from different sets of darts.</p>
    </div>

    <% if @setup_stats.any? %>
      <div class="grid gap-3 md:grid-cols-2">
        <% @setup_stats.each do |stats| %>
          <article class="theme-match-card p-4">
            <div class="mb-3">
              <div class="auth-label mb-1">Setup</div>
              <h3 class="bebas m-0 text-2xl"><%= stats[:setup] %></h3>
            </div>
            <div class="grid grid-cols-2 gap-2 mono text-sm">
              <div><span style="color:var(--theme-subtle)">Matches</span><br><strong><%= stats[:matches] %></strong></div>
              <div><span style="color:var(--theme-subtle)">Average</span><br><strong><%= stats[:average_per_turn] %></strong></div>
              <div><span style="color:var(--theme-subtle)">Highest turn</span><br><strong><%= stats[:highest_turn] %></strong></div>
              <div><span style="color:var(--theme-subtle)">Darts thrown</span><br><strong><%= stats[:darts_thrown] %></strong></div>
              <div><span style="color:var(--theme-subtle)">Double hits</span><br><strong><%= stats[:double_hits] %> (<%= stats[:double_hit_share] %>%)</strong></div>
              <div><span style="color:var(--theme-subtle)">Checkout</span><br><strong><%= stats[:checkout_rate] %>%</strong></div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="flash-theme notice mono">No setup-linked match stats yet. Save a setup, start a match, and stats will appear here.</div>
    <% end %>
  </section>
</div>
