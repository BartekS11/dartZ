<div class="page-shell stack-md">
  <section class="theme-hero p-5">
    <div class="level is-align-items-flex-start mb-4">
      <div class="level-left">
        <div>
          <div class="theme-section-label">Premium</div>
          <h1 class="page-title">Dart setup</h1>
          <p class="page-copy">Save the equipment you use most often.</p>
        </div>
      </div>
      <div class="level-right"><span class="theme-chip is-live"><%= Current.user.account_tier.humanize %></span></div>
    </div>

    <%= form_with model: @dart_setup, url: dart_setup_path, method: :patch, class: "stack-md" do |f| %>
      <% if @dart_setup.errors.any? %>
        <div class="flash-theme alert mono"><%= pluralize(@dart_setup.errors.count, "error") %> prevented this setup from being saved.</div>
      <% end %>

      <div class="columns is-multiline is-variable is-3">
        <div class="column is-6"><div class="field"><%= f.label :manufacturer, "Manufacturer", class: "label auth-label" %><div class="select is-fullwidth"><%= f.select :manufacturer, DartSetup::MANUFACTURER_LABELS.map { |value, label| [label, value] }, {}, class: "theme-form-input mono" %></div></div></div>
        <div class="column is-6"><div class="field"><%= f.label :weight_g, "Weight (g)", class: "label auth-label" %><%= f.number_field :weight_g, min: 10, max: 60, step: 0.1, class: "input theme-form-input mono" %></div></div>
        <div class="column is-6"><div class="field"><%= f.label :shaft_type, "Shaft type", class: "label auth-label" %><div class="select is-fullwidth"><%= f.select :shaft_type, DartSetup::SHAFT_TYPES.map { |type| [type.humanize, type] }, {}, class: "theme-form-input mono" %></div></div></div>
        <div class="column is-6"><div class="field"><%= f.label :shaft_length_mm, "Shaft length (mm)", class: "label auth-label" %><%= f.number_field :shaft_length_mm, min: 20, max: 70, step: 1, class: "input theme-form-input mono" %></div></div>
        <div class="column is-6"><div class="field"><%= f.label :point_length_mm, "Point length (mm)", class: "label auth-label" %><%= f.number_field :point_length_mm, min: 20, max: 60, step: 1, class: "input theme-form-input mono" %></div></div>
      </div>

      <div class="level pt-4" style="border-top:1px solid var(--theme-line)">
        <div class="level-left"><p class="page-copy">Stripe can later update account tier and premium expiry fields.</p></div>
        <div class="level-right"><%= f.submit "Save setup", class: "button theme-btn-primary is-medium" %></div>
      </div>
    <% end %>
  </section>

  <section class="theme-card p-5">
    <div class="mb-4">
      <div class="theme-section-label">Premium stats</div>
      <h2 class="section-title">Stats by dart setup</h2>
      <p class="page-copy">Your current dart setup is snapshotted when matches start, so stats stay accurate after edits.</p>
    </div>

    <% if @setup_stats.any? %>
      <div class="columns is-multiline is-variable is-3">
        <% @setup_stats.each do |stats| %>
          <div class="column is-6-desktop">
            <article class="theme-match-card p-4">
              <div class="mb-3"><div class="auth-label">Setup</div><h3 class="section-title"><%= stats[:setup] %></h3></div>
              <div class="compact-stats-list mono text-sm">
                <div class="compact-stat"><span>Matches</span><strong><%= stats[:matches] %></strong></div>
                <div class="compact-stat"><span>Average</span><strong><%= stats[:average_per_turn] %></strong></div>
                <div class="compact-stat"><span>Highest turn</span><strong><%= stats[:highest_turn] %></strong></div>
                <div class="compact-stat"><span>Darts thrown</span><strong><%= stats[:darts_thrown] %></strong></div>
                <div class="compact-stat"><span>Double hits</span><strong><%= stats[:double_hits] %> (<%= stats[:double_hit_share] %>%)</strong></div>
                <div class="compact-stat"><span>Checkout</span><strong><%= stats[:checkout_rate] %>%</strong></div>
              </div>
            </article>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="flash-theme notice mono">No setup-linked match stats yet. Save a setup, start a match, and stats will appear here.</div>
    <% end %>
  </section>
</div>
