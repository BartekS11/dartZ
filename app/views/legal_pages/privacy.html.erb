<div class="page-shell page-shell-narrow">
  <div class="theme-card p-4 md:p-6">
    <div class="page-header mb-6">
      <div class="theme-section-label mono"><%= t("legal.label") %></div>
      <h1 class="section-title bebas"><%= t("legal.privacy_title") %></h1>
    </div>

    <div class="theme-copy space-y-5 text-sm leading-7">
      <% %w[overview data why cookies sharing rights contact].each do |section| %>
        <section>
          <h2 class="mb-2 text-lg font-semibold"><%= t("legal.privacy.#{section}_title") %></h2>
          <p><%= t("legal.privacy.#{section}_text", app_name: theme_app_name) %></p>
        </section>
      <% end %>
    </div>
  </div>
</div>
