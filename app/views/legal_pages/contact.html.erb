<div class="page-shell page-shell-narrow">
  <div class="theme-card p-4 md:p-6">
    <div class="page-header mb-6">
      <div class="theme-section-label mono"><%= t("legal.label") %></div>
      <h1 class="section-title bebas"><%= t("legal.contact_title") %></h1>
    </div>

    <div class="theme-copy space-y-5 text-sm leading-7">
      <section>
        <h2 class="mb-2 text-lg font-semibold"><%= t("legal.support") %></h2>
        <p><%= t("legal.support_text") %></p>
      </section>

      <section>
        <h2 class="mb-2 text-lg font-semibold"><%= t("legal.privacy_requests") %></h2>
        <p><%= t("legal.privacy_requests_text") %></p>
      </section>

      <section>
        <h2 class="mb-2 text-lg font-semibold"><%= t("legal.helpful_details") %></h2>
        <p><%= t("legal.helpful_details_text") %></p>
      </section>
    </div>
  </div>
</div>
