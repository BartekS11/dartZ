<div class="page-shell page-shell-compact">
  <div class="columns is-variable is-6 is-vcentered" style="min-height:72vh">
    <section class="column">
      <div class="theme-hero p-6">
        <div class="theme-section-label"><%= t("auth.create_account") %></div>
        <h1 class="page-title"><%= t("auth.register_hero") %></h1>
        <p class="page-copy mt-3"><%= t("auth.register_copy") %></p>
      </div>
    </section>

    <section class="column is-5-desktop">
      <div class="auth-card p-5">
        <% if alert = flash[:alert] %><div class="flash-theme alert mono mb-4">⚠ <%= alert %></div><% end %>
        <% if notice = flash[:notice] %><div class="flash-theme notice mono mb-4">⚡ <%= notice %></div><% end %>

        <div class="mb-5">
          <div class="theme-section-label"><%= t("common.account") %></div>
          <h2 class="section-title"><%= t("auth.register_title") %></h2>
        </div>

        <%= form_with model: @user, url: registration_path, class: "stack-md" do |form| %>
          <% if @user.errors.any? %>
            <div class="flash-theme alert mono mb-4">
              <%= @user.errors.full_messages.to_sentence %>
            </div>
          <% end %>

          <div class="field">
            <label class="label auth-label"><%= t("common.email_address") %></label>
            <%= form.email_field :email_address,
                  required: true,
                  autofocus: true,
                  autocomplete: "username",
                  placeholder: t("auth.email_placeholder"),
                  class: "input auth-input" %>
          </div>

          <div class="field">
            <label class="label auth-label"><%= t("common.nickname") %></label>
            <%= form.text_field :nickname,
                  maxlength: 20,
                  autocomplete: "nickname",
                  placeholder: t("auth.nickname_placeholder"),
                  class: "input auth-input" %>
          </div>

          <div class="field">
            <label class="label auth-label"><%= t("common.password") %></label>
            <%= form.password_field :password,
                  required: true,
                  autocomplete: "new-password",
                  placeholder: t("auth.password_placeholder"),
                  maxlength: 72,
                  class: "input auth-input" %>
          </div>

          <div class="field">
            <label class="label auth-label"><%= t("common.confirm_password") %></label>
            <%= form.password_field :password_confirmation,
                  required: true,
                  autocomplete: "new-password",
                  placeholder: t("auth.repeat_password_placeholder"),
                  maxlength: 72,
                  class: "input auth-input" %>
          </div>

          <%= form.submit t("auth.create_account_button"), class: "button theme-btn-primary is-fullwidth is-medium" %>

          <div class="is-flex is-justify-content-space-between pt-3" style="border-top:1px solid var(--theme-line)">
            <%= link_to t("auth.already_have_account"), new_session_path, class: "footer-link" %>
            <%= link_to t("auth.play_as_guest"), matches_path, class: "footer-link" %>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>
