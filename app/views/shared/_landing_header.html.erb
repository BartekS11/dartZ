<nav class="simple-nav landing-nav" aria-label="<%= t('home.navigation') %>">
  <%= link_to root_path, class: "brand-lockup" do %>
    <span class="brand-mark" aria-hidden="true">◎</span>
    <span class="brand-copy">
      <span class="brand-wordmark"><%= theme_app_name.delete(theme_app_accent) %><span><%= theme_app_accent %></span></span>
      <span class="brand-subline"><%= Current.user ? Current.user.display_name : "501" %></span>
    </span>
  <% end %>

  <details class="landing-mobile-menu mobile-nav-menu" open>
    <summary class="mobile-nav-toggle" aria-label="<%= t('home.navigation') %>"><span aria-hidden="true">☰</span><span class="mobile-nav-toggle-label"><%= t('nav.menu') %></span></summary>
    <div class="mobile-nav-content">
  <div class="nav-utilities <%= 'has-account' if Current.user %>">
    <% if Current.user %>
      <span class="landing-user-name mono"><%= Current.user.display_name %></span>
      <%= link_to t("home.your_matches"), matches_path, class: "app-nav-auth-button mono" %>
    <% else %>
      <%= link_to t("nav.tiers"), tiers_path, class: "app-nav-link mono" %>
      <%= link_to t("nav.login"), new_session_path, class: "app-nav-link mono" %>
      <%= link_to t("home.create_account"), new_registration_path, class: "app-nav-auth-button mono" %>
    <% end %>

    <%= render "shared/locale_picker" %>

    <button type="button" class="app-nav-link app-nav-theme-toggle" data-action="theme-mode#toggle" data-theme-mode-target="button" aria-label="<%= t('nav.switch_theme') %>">
      <span aria-hidden="true">◐</span>
      <span data-theme-mode-target="label" class="visually-hidden"><%= t("nav.light_theme") %></span>
    </button>
  </div>
    </div>
  </details>
</nav>
