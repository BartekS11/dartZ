<% invite_url = match_invite_join_url(@match.invite_token) %>

<div class="page-shell stack-lg" data-controller="invite-wait" data-invite-wait-status-url-value="<%= match_invite_status_path(@match) %>">
  <section class="theme-hero p-5 stack-md">
    <div>
      <div class="theme-section-label"><%= t("invites.lobby") %></div>
      <h1 class="page-title"><%= t("invites.waiting_player_2") %></h1>
      <p class="page-copy mt-2"><%= t("invites.share_qr") %></p>
    </div>

    <div class="columns is-variable is-5">
      <div class="column is-narrow">
        <div class="theme-panel p-4 has-background-white">
          <%= qr_code_svg(invite_url) %>
        </div>
      </div>
      <div class="column">
        <div class="theme-panel p-4 stack-sm">
          <div>
            <label class="auth-label"><%= t("invites.invite_link") %></label>
            <input class="input theme-form-input mono" readonly value="<%= invite_url %>">
          </div>
          <div class="buttons">
            <button type="button" class="button theme-btn-primary" data-action="click->invite-wait#copy" data-url="<%= invite_url %>"><%= t("invites.copy_link") %></button>
            <%= button_to t("invites.cancel_invite"), cancel_match_invite_path(@match), method: :delete, class: "button theme-btn-outline", form: { data: { turbo_confirm: t("invites.cancel_confirm") } } %>
          </div>
          <p class="help-theme"><%= t("invites.expires", time: time_tag(@match.invite_expires_at, @match.invite_expires_at.strftime("%d %b %Y %H:%M"))) %></p>
        </div>
      </div>
    </div>

    <% creator_name = @match.players.first&.display_name || t("common.player_1") %>
    <% invitee_name = t("invites.invited_player") %>
    <% invitee_starts = @match.starting_player_position == 2 %>
    <% left_player = invitee_starts ? { label: t("common.player_2"), name: invitee_name } : { label: t("common.player_1"), name: creator_name } %>
    <% right_player = invitee_starts ? { label: t("common.player_1"), name: creator_name } : { label: t("common.player_2"), name: invitee_name } %>
    <% next_starter = invitee_starts ? "creator" : "invitee" %>

    <div class="theme-panel invite-starter-panel">
      <div class="theme-section-label"><%= t("invites.starter") %></div>
      <div class="columns is-variable is-3 is-vcentered mt-2">
        <div class="column">
          <div class="player-card-shell is-selected">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
              <label class="auth-label"><%= left_player[:label] %></label>
              <span class="theme-chip"><%= t("invites.throws_first_badge") %></span>
            </div>
            <div class="input theme-form-input mono has-text-centered" aria-readonly="true"><%= left_player[:name] %></div>
          </div>
        </div>

        <div class="column is-narrow has-text-centered">
          <%= button_to "⇄",
                match_invite_starter_path(@match),
                method: :patch,
                params: { invite_starter: next_starter },
                form: { data: { turbo: false }, class: "invite-starter-swap-form" },
                class: "button theme-btn-outline swap-badge",
                title: t("invites.swap_starter"),
                aria: { label: t("invites.swap_starter") } %>
        </div>

        <div class="column">
          <div class="player-card-shell">
            <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
              <label class="auth-label"><%= right_player[:label] %></label>
            </div>
            <div class="input theme-form-input mono has-text-centered" aria-readonly="true"><%= right_player[:name] %></div>
          </div>
        </div>
      </div>
      <p class="help-theme mt-2"><%= t("invites.first_to_throw", player: left_player[:name]) %></p>
    </div>

    <div class="theme-panel p-4">
      <div class="theme-section-label"><%= t("invites.match_settings") %></div>
      <p class="page-copy mb-2"><%= @match.players.first&.display_name || t("common.player_1") %> vs <%= t("invites.invited_player") %></p>
      <div class="is-flex is-flex-wrap-wrap" style="gap:.45rem">
        <% @match.game_mode_labels.each do |label| %><span class="theme-chip"><%= label %></span><% end %>
        <span class="theme-chip">Bo<%= @match.best_of_legs %> legs</span>
        <% if @match.best_of_sets > 1 %><span class="theme-chip">Bo<%= @match.best_of_sets %> sets</span><% end %>
      </div>
    </div>
  </section>
</div>
