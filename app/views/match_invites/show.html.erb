<% invite_url = match_invite_join_url(@match.invite_token) %>

<div class="page-shell stack-lg" data-controller="invite-wait" data-invite-wait-status-url-value="<%= match_invite_status_path(@match) %>">
  <section class="theme-hero p-5 stack-md">
    <div>
      <div class="theme-section-label">Invite lobby</div>
      <h1 class="page-title">Waiting for Player 2</h1>
      <p class="page-copy mt-2">Share this QR code or link. The match starts automatically when the second player joins.</p>
    </div>

    <div class="columns is-variable is-5">
      <div class="column is-narrow">
        <div class="theme-panel p-4 has-background-white">
          <%= qr_code_svg(invite_url) %>
        </div>
      </div>
      <div class="column">
        <div class="theme-panel p-4 stack-sm">
          <div>
            <label class="auth-label">Invite link</label>
            <input class="input theme-form-input mono" readonly value="<%= invite_url %>">
          </div>
          <div class="buttons">
            <button type="button" class="button theme-btn-primary" data-action="click->invite-wait#copy" data-url="<%= invite_url %>">Copy link</button>
            <%= button_to "Cancel invite", cancel_match_invite_path(@match), method: :delete, class: "button theme-btn-outline", form: { data: { turbo_confirm: "Cancel this invite match?" } } %>
          </div>
          <p class="help-theme">Expires <%= time_tag @match.invite_expires_at, @match.invite_expires_at.strftime("%d %b %Y %H:%M") %>.</p>
        </div>
      </div>
    </div>

    <div class="theme-panel p-4">
      <div class="theme-section-label">Match settings</div>
      <p class="page-copy mb-2"><%= @match.players.first&.display_name || "Player 1" %> vs invited player</p>
      <div class="is-flex is-flex-wrap-wrap" style="gap:.45rem">
        <% @match.game_mode_labels.each do |label| %><span class="theme-chip"><%= label %></span><% end %>
        <span class="theme-chip">Bo<%= @match.best_of_legs %> legs</span>
        <% if @match.best_of_sets > 1 %><span class="theme-chip">Bo<%= @match.best_of_sets %> sets</span><% end %>
      </div>
    </div>
  </section>
</div>
