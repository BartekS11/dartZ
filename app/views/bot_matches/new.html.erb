<div class="page-shell">
  <div class="columns is-variable is-5">
    <section class="column is-4-desktop">
      <div class="theme-hero p-5 h-full">
        <div class="theme-section-label">Bot challenge</div>
        <h1 class="page-title">Practice with a clean setup.</h1>
        <p class="page-copy mt-3">Choose a level, start fast, and keep the interface simple.</p>
        <div class="stack-sm mt-5">
          <div class="theme-chip">Level 1–5 · beginner rhythm</div>
          <div class="theme-chip">Level 6–12 · steady scoring</div>
          <div class="theme-chip">Level 13–17 · strong finishing</div>
          <div class="theme-chip">Level 18–20 · near-pro pressure</div>
        </div>
      </div>
    </section>

    <section class="column">
      <div class="theme-card p-5">
        <div class="level is-align-items-flex-end mb-5">
          <div class="level-left"><div><div class="theme-section-label">New bot match</div><h2 class="section-title">Setup</h2></div></div>
          <div class="level-right"><%= link_to "← Back", matches_path, class: "button theme-btn-outline mono" %></div>
        </div>

        <%= form_with url: bot_match_path, method: :post, data: { turbo: false }, class: "stack-md" do |f| %>
          <div class="columns is-variable is-3">
            <div class="column"><div class="field"><label class="label auth-label">Your name</label><%= f.text_field :player_name, value: Current.user.display_name, placeholder: "Your name", maxlength: 20, autocomplete: "off", class: "input theme-form-input mono" %></div></div>
            <div class="column"><div class="field"><label class="label auth-label">Bot name</label><%= f.text_field :bot_name, placeholder: "Optional bot name", maxlength: 20, autocomplete: "off", class: "input theme-form-input mono" %></div></div>
          </div>

          <div class="theme-panel p-4 stack-md">
            <label class="auth-label">Bot difficulty</label>
            <% [["Beginner", (1..5).to_a], ["Intermediate", (6..12).to_a], ["Advanced", (13..17).to_a], ["Pro", (18..20).to_a]].each do |label, levels| %>
              <div>
                <div class="auth-label mb-2"><%= label %></div>
                <div class="buttons are-small">
                  <% levels.each do |lvl| %>
                    <button type="button" class="button theme-btn-outline mono bot-level-btn <%= 'is-selected' if lvl == 10 %>" onclick="document.getElementById('bot_level').value=<%= lvl.to_json %>; document.querySelectorAll('.bot-level-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')"><%= lvl %></button>
                  <% end %>
                </div>
              </div>
            <% end %>
            <%= f.hidden_field :bot_level, value: 10, id: "bot_level" %>
          </div>

          <div class="columns is-variable is-3">
            <div class="column">
              <div class="theme-panel p-4">
                <div class="auth-label mb-2">Starting score</div>
                <div class="buttons are-small">
                  <% Match::X01_STARTING_SCORES.each do |score| %>
                    <button type="button" class="button theme-btn-outline mono bot-score-btn <%= 'is-selected' if score == 501 %>" onclick="document.getElementById('starting_score').value=<%= score.to_json %>; document.querySelectorAll('.bot-score-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')"><%= score %></button>
                  <% end %>
                </div>
                <%= f.hidden_field :starting_score, value: 501, id: "starting_score" %>
              </div>
            </div>
            <div class="column"><label class="panel-choice"><%= hidden_field_tag :double_in, "0" %><%= check_box_tag :double_in, "1", false %> Double in</label><label class="panel-choice mt-3"><%= hidden_field_tag :double_out, "0" %><%= check_box_tag :double_out, "1", true %> Double out</label></div>
          </div>

          <div class="columns is-variable is-3">
            <div class="column">
              <div class="theme-panel p-4"><div class="auth-label mb-2">Best of legs</div><div class="buttons are-small">
                <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %><button type="button" class="button theme-btn-outline mono bot-legs-btn <%= 'is-selected' if val == 1 %>" onclick="document.getElementById('best_of_legs').value=<%= val.to_json %>; document.querySelectorAll('.bot-legs-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')"><%= label %></button><% end %>
              </div><%= f.hidden_field :best_of_legs, value: 1, id: "best_of_legs" %></div>
            </div>
            <div class="column">
              <div class="theme-panel p-4"><div class="auth-label mb-2">Best of sets</div><div class="buttons are-small">
                <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %><button type="button" class="button theme-btn-outline mono bot-sets-btn <%= 'is-selected' if val == 1 %>" onclick="document.getElementById('best_of_sets').value=<%= val.to_json %>; document.querySelectorAll('.bot-sets-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')"><%= label %></button><% end %>
              </div><%= f.hidden_field :best_of_sets, value: 1, id: "best_of_sets" %></div>
            </div>
          </div>

          <div class="buttons is-justify-content-flex-end">
            <%= link_to "Cancel", matches_path, class: "button theme-btn-outline mono" %>
            <%= f.submit "Start match", class: "button theme-btn-primary is-medium" %>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>
