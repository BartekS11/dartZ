<div class="row justify-content-center g-4">
  <div class="col-12 col-xl-9">
    <div class="row g-4 align-items-start">
      <div class="col-12 col-lg-4">
        <div class="mb-4">
          <div class="theme-section-label mono mb-2">Bot challenge</div>
          <h1 class="theme-section-title bebas mb-2">Play vs Bot</h1>
          <p class="theme-subtitle mb-0">Pick a name, set the bot level, and start a compact 501 session fast.</p>
        </div>

        <div class="theme-card p-3 p-md-4">
          <div class="theme-section-label mono mb-2">Quick notes</div>
          <div class="d-grid gap-2">
            <div class="theme-chip mono">Bot level 1–5 · beginner</div>
            <div class="theme-chip mono">6–12 · steady scoring</div>
            <div class="theme-chip mono">13–17 · strong finisher</div>
            <div class="theme-chip mono">18–20 · near-pro pressure</div>
          </div>
        </div>
      </div>

      <div class="col-12 col-lg-8">
        <div class="theme-card p-3 p-md-4">
          <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-4">
            <div>
              <div class="theme-section-label mono mb-1">New bot match</div>
              <h2 class="bebas fs-2 mb-0">Compact setup</h2>
            </div>
            <%= link_to "← Back", matches_path, class: "btn theme-btn-outline rounded-pill mono" %>
          </div>

          <%= form_with url: bot_match_path, method: :post, data: { turbo: false } do |f| %>
            <div class="row g-3 mb-3">
              <div class="col-12 col-md-6">
                <label class="mono text-subtle-theme small text-uppercase mb-2 d-block">Your name</label>
                <%= f.text_field :player_name,
                      value: Current.user.display_name,
                      placeholder: "Your name",
                      maxlength: 20,
                      autocomplete: "off",
                      class: "form-control theme-form-input mono" %>
              </div>

              <div class="col-12 col-md-6">
                <label class="mono text-subtle-theme small text-uppercase mb-2 d-block">Bot name</label>
                <%= f.text_field :bot_name,
                      placeholder: "Optional bot name",
                      maxlength: 20,
                      autocomplete: "off",
                      class: "form-control theme-form-input mono" %>
              </div>
            </div>

            <div class="theme-panel p-3 mb-3">
              <label class="mono text-subtle-theme small text-uppercase mb-3 d-block">Bot difficulty</label>
              <div class="d-grid gap-3">
                <% [["Beginner", (1..5).to_a], ["Intermediate", (6..12).to_a], ["Advanced", (13..17).to_a], ["Pro", (18..20).to_a]].each do |label, levels| %>
                  <div>
                    <div class="mono text-subtle-theme" style="font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:0.45rem;"><%= label %></div>
                    <div class="d-flex flex-wrap gap-2">
                      <% levels.each do |lvl| %>
                        <button type="button"
                                class="btn btn-sm theme-btn-outline rounded-pill mono bot-level-btn <%= 'border-danger text-danger' if lvl == 10 %>"
                                onclick="document.getElementById('bot_level').value=<%= lvl.to_json %>; document.querySelectorAll('.bot-level-btn').forEach(b => b.classList.remove('border-danger','text-danger')); this.classList.add('border-danger','text-danger')">
                          <%= lvl %>
                        </button>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
              <%= f.hidden_field :bot_level, value: 10, id: "bot_level" %>
            </div>

            <div class="theme-panel p-3 mb-4">
              <label class="mono text-subtle-theme small text-uppercase mb-3 d-block">Match format</label>
              <div class="row g-3">
                <div class="col-12 col-md-6">
                  <div class="mono text-subtle-theme" style="font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:0.45rem;">Best of legs</div>
                  <div class="d-flex flex-wrap gap-2">
                    <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                      <button type="button"
                              class="btn btn-sm theme-btn-outline rounded-pill mono bot-legs-btn <%= 'border-danger text-danger' if val == 1 %>"
                              onclick="document.getElementById('best_of_legs').value=<%= val.to_json %>; document.querySelectorAll('.bot-legs-btn').forEach(b => b.classList.remove('border-danger','text-danger')); this.classList.add('border-danger','text-danger')">
                        <%= label %>
                      </button>
                    <% end %>
                  </div>
                  <%= f.hidden_field :best_of_legs, value: 1, id: "best_of_legs" %>
                </div>

                <div class="col-12 col-md-6">
                  <div class="mono text-subtle-theme" style="font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:0.45rem;">Best of sets</div>
                  <div class="d-flex flex-wrap gap-2">
                    <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                      <button type="button"
                              class="btn btn-sm theme-btn-outline rounded-pill mono bot-sets-btn <%= 'border-danger text-danger' if val == 1 %>"
                              onclick="document.getElementById('best_of_sets').value=<%= val.to_json %>; document.querySelectorAll('.bot-sets-btn').forEach(b => b.classList.remove('border-danger','text-danger')); this.classList.add('border-danger','text-danger')">
                        <%= label %>
                      </button>
                    <% end %>
                  </div>
                  <%= f.hidden_field :best_of_sets, value: 1, id: "best_of_sets" %>
                </div>
              </div>
            </div>

            <div class="d-grid d-md-flex gap-3 justify-content-end">
              <%= link_to "Cancel", matches_path, class: "btn theme-btn-outline rounded-pill mono" %>
              <%= f.submit "Start Match",
                    class: "btn theme-btn-primary rounded-pill bebas fs-4 px-4" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
