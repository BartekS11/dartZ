<div class="page-shell page-shell-narrow stack-lg simple-setup">
  <section class="theme-hero p-5">
    <div class="level is-align-items-flex-start mb-4">
      <div class="level-left">
        <div>
          <div class="theme-section-label"><%= t("bot_matches.challenge") %></div>
          <h1 class="page-title"><%= t("bot_matches.practice") %></h1>
          <p class="page-copy mt-3"><%= t("bot_matches.intro") %></p>
        </div>
      </div>
      <div class="level-right"><%= link_to t("common.back"), matches_path, class: "button theme-btn-outline mono" %></div>
    </div>
  </section>

  <section class="theme-card p-5">
    <%= form_with url: bot_match_path, method: :post, data: { turbo: false }, class: "stack-md" do |f| %>
      <section class="tournament-form-section">
        <div class="theme-section-label"><%= t("common.names") %></div>
        <div class="grid gap-4 md:grid-cols-2 mt-3">
          <div>
            <label class="auth-label" for="player_name"><%= t("common.your_name") %></label>
            <%= f.text_field :player_name, value: Current.user.display_name, placeholder: t("common.your_name"), maxlength: 20, autocomplete: "off", class: "input theme-form-input mono" %>
          </div>
          <div>
            <label class="auth-label" for="bot_name"><%= t("bot_matches.bot_name") %></label>
            <%= f.text_field :bot_name, placeholder: t("bot_matches.bot_name_placeholder"), maxlength: 20, autocomplete: "off", class: "input theme-form-input mono" %>
          </div>
        </div>
      </section>

      <section class="tournament-form-section">
        <div class="theme-section-label"><%= t("bot_matches.difficulty") %></div>
        <p class="page-copy mt-1"><%= t("bot_matches.level_help") %></p>
        <div class="buttons are-small mt-3">
          <% (BotService::MIN_LEVEL..BotService::MAX_LEVEL).each do |level| %>
            <label class="button theme-btn-outline mono bot-choice-radio <%= 'is-selected' if level == BotService::DEFAULT_LEVEL %>" title="<%= t("bot_matches.levels.#{level}") %>">
              <%= radio_button_tag :bot_level, level, level == BotService::DEFAULT_LEVEL, class: "sr-only", onchange: "this.closest('.buttons').querySelectorAll('.bot-choice-radio').forEach(el => el.classList.remove('is-selected')); this.closest('.bot-choice-radio').classList.add('is-selected'); document.getElementById('bot-level-description').textContent = this.dataset.description", data: { description: t("bot_matches.levels.#{level}") } %>
              <span><%= level %></span>
            </label>
          <% end %>
        </div>
        <p id="bot-level-description" class="help-theme mono"><%= t("bot_matches.levels.#{BotService::DEFAULT_LEVEL}") %></p>
      </section>

      <section class="tournament-form-section">
        <div class="theme-section-label"><%= t("common.rules") %></div>
        <div class="grid gap-4 md:grid-cols-3 mt-3">
          <div>
            <label class="auth-label"><%= t("common.starting_score") %></label>
            <%= select_tag :starting_score, options_for_select(Match::X01_STARTING_SCORES, 501), class: "select theme-form-input mono" %>
          </div>
          <div>
            <label class="auth-label"><%= t("common.best_of_legs") %></label>
            <%= select_tag :best_of_legs, options_for_select([["1", 1], ["Bo3", 3], ["Bo5", 5]], 1), class: "select theme-form-input mono" %>
          </div>
          <div>
            <label class="auth-label"><%= t("common.best_of_sets") %></label>
            <%= select_tag :best_of_sets, options_for_select([["1", 1], ["Bo3", 3], ["Bo5", 5]], 1), class: "select theme-form-input mono" %>
          </div>
        </div>

        <div class="grid gap-3 md:grid-cols-2 mt-4">
          <label class="panel-choice"><%= hidden_field_tag :double_in, "0" %><%= check_box_tag :double_in, "1", false %> <%= t("common.double_in") %></label>
          <label class="panel-choice"><%= hidden_field_tag :double_out, "0" %><%= check_box_tag :double_out, "1", true %> <%= t("common.double_out") %></label>
        </div>
      </section>

      <div class="buttons is-justify-content-flex-end pt-4" style="border-top:1px solid var(--theme-line)">
        <%= link_to t("common.cancel"), matches_path, class: "button theme-btn-outline mono" %>
        <%= f.submit t("bot_matches.start_practice"), class: "button theme-btn-primary is-medium" %>
      </div>
    <% end %>
  </section>
</div>
