<div class="page-shell">
  <div class="grid gap-6 lg:grid-cols-[22rem_minmax(0,1fr)]">
    <section class="theme-hero counter-setup-card p-5 md:p-6">
      <div class="page-header">
        <div class="theme-section-label mono">Bot challenge</div>
        <h1 class="page-title bebas">Practice with a clean setup.</h1>
        <p class="page-copy">Choose a level, start fast, and keep the interface simple.</p>
      </div>

      <div class="mt-5 grid gap-2">
        <div class="theme-chip mono justify-start">Level 1–5 · beginner rhythm</div>
        <div class="theme-chip mono justify-start">Level 6–12 · steady scoring</div>
        <div class="theme-chip mono justify-start">Level 13–17 · strong finishing</div>
        <div class="theme-chip mono justify-start">Level 18–20 · near-pro pressure</div>
      </div>
    </section>

    <section class="theme-card counter-setup-card p-5 md:p-6">
      <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div class="counter-section-header">
          <div class="theme-section-label mono">New bot match</div>
          <h2 class="section-title bebas">Setup</h2>
        </div>
        <%= link_to "← Back", matches_path, class: "btn theme-btn-outline rounded-pill mono" %>
      </div>

      <%= form_with url: bot_match_path, method: :post, data: { turbo: false } do |f| %>
        <div class="grid gap-4 md:grid-cols-2">
          <div>
            <label class="auth-label">Your name</label>
            <%= f.text_field :player_name,
                  value: Current.user.display_name,
                  placeholder: "Your name",
                  maxlength: 20,
                  autocomplete: "off",
                  class: "form-control theme-form-input mono" %>
          </div>

          <div>
            <label class="auth-label">Bot name</label>
            <%= f.text_field :bot_name,
                  placeholder: "Optional bot name",
                  maxlength: 20,
                  autocomplete: "off",
                  class: "form-control theme-form-input mono" %>
          </div>
        </div>

        <div class="theme-panel counter-list-card mt-4 p-4">
          <label class="auth-label">Bot difficulty</label>
          <div class="grid gap-4">
            <% [["Beginner", (1..5).to_a], ["Intermediate", (6..12).to_a], ["Advanced", (13..17).to_a], ["Pro", (18..20).to_a]].each do |label, levels| %>
              <div>
                <div class="auth-label mb-2"><%= label %></div>
                <div class="flex flex-wrap gap-2">
                  <% levels.each do |lvl| %>
                    <button type="button"
                            class="btn btn-sm theme-btn-outline rounded-pill mono bot-level-btn <%= 'is-selected' if lvl == 10 %>"
                            onclick="document.getElementById('bot_level').value=<%= lvl.to_json %>; document.querySelectorAll('.bot-level-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')">
                      <%= lvl %>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
          <%= f.hidden_field :bot_level, value: 10, id: "bot_level" %>
        </div>

        <div class="mt-4 grid gap-4 md:grid-cols-2">
          <div class="theme-panel counter-list-card p-4">
            <div class="auth-label">Best of legs</div>
            <div class="flex flex-wrap gap-2">
              <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                <button type="button"
                        class="btn btn-sm theme-btn-outline rounded-pill mono bot-legs-btn <%= 'is-selected' if val == 1 %>"
                        onclick="document.getElementById('best_of_legs').value=<%= val.to_json %>; document.querySelectorAll('.bot-legs-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')">
                  <%= label %>
                </button>
              <% end %>
            </div>
            <%= f.hidden_field :best_of_legs, value: 1, id: "best_of_legs" %>
          </div>

          <div class="theme-panel counter-list-card p-4">
            <div class="auth-label">Best of sets</div>
            <div class="flex flex-wrap gap-2">
              <% [[1, "1"], [3, "Bo3"], [5, "Bo5"]].each do |val, label| %>
                <button type="button"
                        class="btn btn-sm theme-btn-outline rounded-pill mono bot-sets-btn <%= 'is-selected' if val == 1 %>"
                        onclick="document.getElementById('best_of_sets').value=<%= val.to_json %>; document.querySelectorAll('.bot-sets-btn').forEach(b => b.classList.remove('is-selected')); this.classList.add('is-selected')">
                  <%= label %>
                </button>
              <% end %>
            </div>
            <%= f.hidden_field :best_of_sets, value: 1, id: "best_of_sets" %>
          </div>
        </div>

        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-end">
          <%= link_to "Cancel", matches_path, class: "btn theme-btn-outline rounded-pill mono" %>
          <%= f.submit "Start match", class: "btn theme-btn-primary rounded-pill px-4 py-3 bebas text-xl" %>
        </div>
      <% end %>
    </section>
  </div>
</div>
