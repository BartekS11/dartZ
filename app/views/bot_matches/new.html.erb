<style>
  .level-btn {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid #2a2a2a;
    background: #111;
    color: #555;
    cursor: pointer;
    transition: all 0.15s ease;
    touch-action: manipulation;
  }
  .level-btn:hover, .level-btn.active {
    border-color: #dc2626;
    color: #ef4444;
    background: rgba(220,38,38,0.08);
  }
  .level-group-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.55rem;
    letter-spacing: 0.15em;
    color: #333;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
</style>

<div class="mb-8">
  <div class="flex items-center gap-3 mb-1">
    <div class="w-8 h-1 bg-red-600"></div>
    <span class="text-red-600 text-xs tracking-widest uppercase mono">dartZ</span>
  </div>
  <h1 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(2rem,6vw,3rem);
             color:#f5f5f5;letter-spacing:0.02em">
    Play vs Bot
  </h1>
  <p class="text-zinc-500 text-sm mt-1">Challenge the AI at your skill level</p>
</div>

<%= form_with url: bot_match_path, method: :post, data: { turbo: false } do |f| %>

  <%# Player name %>
  <div class="panel p-5 mb-4">
    <p class="mono text-xs text-zinc-600 tracking-widest uppercase mb-3">Your Name</p>
    <%= f.text_field :player_name,
          value: Current.user.email_address,
          placeholder: "Your name",
          maxlength: 20,
          autocomplete: "off",
          class: "w-full bg-zinc-950 border border-zinc-800 text-white
                  font-mono text-sm px-3 py-2 rounded-lg
                  focus:outline-none focus:border-red-600" %>
  </div>

  <%# Bot name %>
  <div class="panel p-5 mb-4">
    <p class="mono text-xs text-zinc-600 tracking-widest uppercase mb-3">Bot Name <span class="text-zinc-700">(optional)</span></p>
    <%= f.text_field :bot_name,
          placeholder: "e.g. Robo-Dart",
          maxlength: 20,
          autocomplete: "off",
          class: "w-full bg-zinc-950 border border-zinc-800 text-white
                  font-mono text-sm px-3 py-2 rounded-lg
                  focus:outline-none focus:border-red-600" %>
  </div>

  <%# Bot level %>
  <div class="panel p-5 mb-4">
    <p class="mono text-xs text-zinc-600 tracking-widest uppercase mb-4">Bot Difficulty</p>

    <div class="space-y-3">
      <% [["BEGINNER", (1..5).to_a, "#22c55e"],
          ["INTERMEDIATE", (6..12).to_a, "#f59e0b"],
          ["ADVANCED", (13..17).to_a, "#ef4444"],
          ["PRO", (18..20).to_a, "#dc2626"]].each do |label, levels, color| %>
        <div>
          <p class="level-group-label" style="color:<%= color %>20"><%= label %></p>
          <div class="flex flex-wrap gap-1.5">
            <% levels.each do |lvl| %>
              <button type="button"
                      class="level-btn <%= lvl == 10 ? 'active' : '' %>"
                      onclick="document.getElementById('bot_level').value=<%= lvl.to_json %>;
                               document.querySelectorAll('.level-btn').forEach(b=>b.classList.remove('active'));
                               this.classList.add('active')">
                <%= lvl %>
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%= f.hidden_field :bot_level, value: 10, id: "bot_level" %>
  </div>

  <%# Format — reuse same format section %>
  <div class="panel p-5 mb-4">
    <p class="mono text-xs text-zinc-600 tracking-widest uppercase mb-3">Match Format</p>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="mono text-xs text-zinc-700 tracking-widest mb-2">LEGS</p>
        <div class="flex gap-1.5 flex-wrap mb-2">
          <% [[1,"1"],[3,"Bo3"],[5,"Bo5"]].each do |val, label| %>
            <button type="button"
                    class="level-btn <%= val == 1 ? 'active' : '' %>"
                    onclick="document.getElementById('best_of_legs').value=<%= val.to_json %>;
                             this.closest('.panel').querySelectorAll('.flex.gap-1\\.5:first-of-type .level-btn').forEach(b=>b.classList.remove('active'));
                             this.classList.add('active')">
              <%= label %>
            </button>
          <% end %>
        </div>
        <%= f.hidden_field :best_of_legs, value: 1, id: "best_of_legs" %>
      </div>
      <div>
        <p class="mono text-xs text-zinc-700 tracking-widest mb-2">SETS</p>
        <div class="flex gap-1.5 flex-wrap mb-2">
          <% [[1,"1"],[3,"Bo3"],[5,"Bo5"]].each do |val, label| %>
            <button type="button"
                    class="level-btn <%= val == 1 ? 'active' : '' %>"
                    onclick="document.getElementById('best_of_sets').value=<%= val.to_json %>;
                             this.classList.add('active')">
              <%= label %>
            </button>
          <% end %>
        </div>
        <%= f.hidden_field :best_of_sets, value: 1, id: "best_of_sets" %>
      </div>
    </div>
  </div>

  <button type="submit"
          style="font-family:'Bebas Neue',sans-serif;font-size:1rem;letter-spacing:0.1em;
                 background:#dc2626;color:#fff;border:1px solid #ef4444;
                 width:100%;padding:12px;border-radius:6px;cursor:pointer;
                 transition:all 0.15s ease;touch-action:manipulation">
    START MATCH →
  </button>

<% end %>
