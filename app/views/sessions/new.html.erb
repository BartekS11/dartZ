<div class="page-shell flex min-h-[72vh] items-center">
  <div class="grid w-full gap-6 lg:grid-cols-[minmax(0,1fr)_26rem] lg:items-center">
    <section class="theme-hero counter-setup-card p-6 md:p-8">
      <div class="page-header">
        <div class="theme-section-label mono">Welcome back</div>
        <h1 class="page-title bebas">Sign in and keep your matches close.</h1>
        <p class="page-copy max-w-xl">Same palette, cleaner structure, and full light/dark support.</p>
      </div>
    </section>

    <section class="auth-card counter-auth-card">
      <% if alert = flash[:alert] %>
        <div class="flash-theme alert mono mb-4">⚠ <%= alert %></div>
      <% end %>

      <% if notice = flash[:notice] %>
        <div class="flash-theme notice mono mb-4">⚡ <%= notice %></div>
      <% end %>

      <div class="counter-section-header mb-5">
        <div class="theme-section-label mono">Account</div>
        <h2 class="section-title bebas">Sign in</h2>
      </div>

      <%= form_with url: session_url, class: "space-y-5" do |form| %>
        <div>
          <label class="auth-label">Email address</label>
          <%= form.email_field :email_address,
                required: true,
                autofocus: true,
                autocomplete: "username",
                placeholder: "Enter your email address",
                value: params[:email_address],
                class: "auth-input" %>
        </div>

        <div>
          <label class="auth-label">Password</label>
          <%= form.password_field :password,
                required: true,
                autocomplete: "current-password",
                placeholder: "Enter your password",
                maxlength: 72,
                class: "auth-input" %>
        </div>

        <%= form.submit "Sign in", class: "btn theme-btn-primary w-full rounded-pill py-3 bebas text-xl" %>

        <div class="flex items-center justify-between gap-3 border-t pt-3" style="border-color:var(--theme-line)">
          <%= link_to "Forgot password?", new_password_path, class: "auth-link" %>
          <%= link_to "Play as guest", matches_path, class: "auth-link" %>
        </div>
      <% end %>
    </section>
  </div>
</div>
