# Local admin console configuration. Copy to .env and replace every value.
ADMIN_EMAIL=operator@example.com
ADMIN_PASSWORD=replace-with-at-least-16-characters
ADMIN_PATH=replace-with-an-unpredictable-path-segment

# Roadmap features remain off until their implementation phase is complete.
ADVANCED_STATS_ENABLED=false
EXPANDED_TRAINING_ENABLED=false
FRIENDS_ENABLED=false
WEB_PUSH_ENABLED=false
# Required in production when Web Push is enabled. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.com
OFFLINE_SCORING_ENABLED=false

# Stripe billing configuration. Use test-mode values locally; never commit live keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_USD_PRICE_ID=
STRIPE_PRO_USD_PRICE_ID=
STRIPE_PREMIUM_PLN_PRICE_ID=
STRIPE_PRO_PLN_PRICE_ID=
STRIPE_PREMIUM_GBP_PRICE_ID=
STRIPE_PRO_GBP_PRICE_ID=

# Password reset email. Use your provider's verified sender and STARTTLS SMTP credentials.
MAILER_FROM="DartZ <noreply@dartz.pl>"
MAILER_HOST=dartz.pl
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_DOMAIN=dartz.pl

# Set only when intentionally rebuilding local demo data with db:seed.
SEED_DEMO_DATA=false
