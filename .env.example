# Local admin console configuration. Copy to .env and replace every value.
ADMIN_EMAIL=operator@example.com
ADMIN_PASSWORD=replace-with-at-least-16-characters
ADMIN_PATH=replace-with-an-unpredictable-path-segment

# Roadmap features remain off until their implementation phase is complete.
ADVANCED_STATS_ENABLED=false
EXPANDED_TRAINING_ENABLED=false
FRIENDS_ENABLED=false
WEB_PUSH_ENABLED=false
OFFLINE_SCORING_ENABLED=false

# Set only when intentionally rebuilding local demo data with db:seed.
SEED_DEMO_DATA=false
